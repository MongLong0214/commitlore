+@dataclass(frozen=True)  # noqa: SLOTS_OK -- dataclass slots require Python 3.10.
+class EvidenceReadFallback:
+    """Absent evidence shaped by the vocabulary of a failed reader."""
+
+    evidence_names: frozenset[str]
+
+    @classmethod
+    def from_reader(cls, reader: "EvidenceReader") -> "EvidenceReadFallback":
+        return cls(reader.evidence_names)
+
+    def items(self) -> tuple[Evidence, ...]:
+        return tuple(Evidence(name, frozenset(), ClaimBasis.ABSENT) for name in self.evidence_names)
