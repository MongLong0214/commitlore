+    validated: Omit<CapabilityMatrixValidationSuccess, "ok" | "errors">
+  ): CapabilityMatrixValidationResult {
+    if (errors.length > 0) return { ok: false, errors };
+    return { ok: true, errors, ...validated };
+  }
+}
