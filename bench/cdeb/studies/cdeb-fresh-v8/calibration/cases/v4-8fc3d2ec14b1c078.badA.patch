 class TestPaging:
+    @pytest.mark.parametrize(
+        ("argument", "value"),
+        [
+            ("pages", 0),
+            ("pages", -1),
+            ("per_page", 0),
+            ("per_page", -1),
+            ("per_page", 101),
+        ],
+    )
+    def test_invalid_paging_is_rejected_before_a_request(self, argument: str, value: int) -> None:
+        transport = FakeTransport([(200, OK, page([]))])
+
+        with pytest.raises(ValueError):
+            collect("q", transport=transport, **{argument: value})
+
+        assert transport.urls == []
+
+    @pytest.mark.parametrize("per_page", [1, 100])
+    def test_github_per_page_boundaries_are_valid(self, per_page: int) -> None:
+        transport = FakeTransport([(200, OK, page([]))])
+
+        collect("q", transport=transport, per_page=per_page)
+
+        assert len(transport.urls) == 1
+
+    def test_a_bare_403_is_retried_once(self) -> None:
