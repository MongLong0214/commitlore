+def test_history_limit_returns_recent_runs_in_append_order(tmp_path) -> None:
+    # Given: three persisted artifacts, including a correction relationship.
+    first = artifact(stars=4)
+    second = artifact(stars=7)
+    third = artifact(stars=9)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", first)
+        store.save("second", second)
+        store.save("third", third, corrects_run_id="second")
+
+        # When: callers request only the most recently appended two runs.
+        recent = store.history(limit=2)
+
+        # Then: the retained slice is still ordered from older to newer.
+        assert [run.run_id for run in store.history()] == ["first", "second", "third"]
+        assert [(run.run_id, run.corrects_run_id) for run in recent] == [
+            ("second", None),
+            ("third", "second"),
+        ]
+        assert [run.artifact.to_bytes() for run in recent] == [second.to_bytes(), third.to_bytes()]
+
+
+def test_observations_limit_returns_recent_records_in_append_order(tmp_path) -> None:
+    # Given: three persisted artifacts that each derive one observation.
+    moments = tuple(
+        datetime(2026, 7, 27 + day, 12, 0, tzinfo=timezone.utc) for day in range(3)
+    )
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for run_id, stars, observed_at in zip(("first", "second", "third"), (4, 7, 9), moments):
+            store.save(run_id, artifact(stars=stars, at=observed_at))
+
+        # When: callers request only the most recently appended two observations.
+        recent = store.observations(limit=2)
+
+        # Then: derived observation values and append order are preserved.
+        assert [observation.run_id for observation in store.observations()] == [
+            "first",
+            "second",
+            "third",
+        ]
+        assert [
+            (observation.run_id, observation.repo, observation.observed_at, observation.stars)
+            for observation in recent
+        ] == [
+            ("second", "org/repo", moments[1], 7),
+            ("third", "org/repo", moments[2], 9),
+        ]
+
+
+@pytest.mark.parametrize("method", ("history", "observations"))
+@pytest.mark.parametrize("limit", (0, -1))
+def test_recent_read_limit_must_be_positive(tmp_path, method, limit) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(ValueError, match="limit must be positive"):
+            getattr(store, method)(limit=limit)
+
+
