+def test_unreadable_files_record_absence_in_the_configured_evidence_vocabulary() -> None:
+    class CustomEvidence:
+        evidence_names = frozenset({"files", "manifest_entries", "dependencies", "source", "custom"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("files unavailable means evidence must not be read")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(Repository(), Files(OSError("offline")), Model(), Clock(), CustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+
+    trace = artifact.repositories[0]
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
+    assert trace.category_evidence == tuple(
+        Evidence(name, frozenset(), ClaimBasis.ABSENT)
+        for name in ("custom", "dependencies", "files", "manifest_entries", "source")
+    )
+
+
+def test_unsupported_category_pack_fails_before_any_operational_port_is_called() -> None:
+    class UnsupportedEvidence:
+        evidence_names = frozenset({"files"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("unsupported evidence reader must not be called")
+
+    class Uncalled:
+        def __getattr__(self, name):
+            raise AssertionError(f"{name} must not be called")
+
+    with pytest.raises(
+        ValueError,
+        match="category pack 'coding-agents' names unavailable evidence: source",
+    ):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(Uncalled(), Uncalled(), Uncalled(), Uncalled(), UnsupportedEvidence()),
+        )
