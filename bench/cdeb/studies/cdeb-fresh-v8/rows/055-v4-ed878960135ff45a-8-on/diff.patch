+def test_observations_order_by_recorded_time_then_recording_sequence(tmp_path) -> None:
+    # Given: a newer observation is saved before a backfill and another run at the same time.
+    later = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("newer-first", artifact(stars=9, at=later))
+        store.save("backfill", artifact(stars=4, at=AT))
+        store.save("newer-second", artifact(stars=12, at=later))
+
+        # When: the recorded observation history is read.
+        observations = store.observations()
+
+    # Then: it is chronological, with equal times retaining recording sequence.
+    assert [(observation.run_id, observation.observed_at, observation.stars) for observation in observations] == [
+        ("backfill", AT, 4),
+        ("newer-first", later, 9),
+        ("newer-second", later, 12),
+    ]
+
+
