+def test_get_returns_a_stored_correction_with_its_lineage(tmp_path) -> None:
+    # Given: a correction has been saved after the run it corrects.
+    corrected = artifact()
+    correction = artifact(stars=9)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("run-1", corrected)
+        store.save("run-2", correction, corrects_run_id="run-1")
+
+        # When: the correction is retrieved directly by its known identifier.
+        stored = store.get("run-2")
+
+        # Then: it retains both its own artifact and its immutable correction link.
+        assert stored.run_id == "run-2"
+        assert stored.corrects_run_id == "run-1"
+        assert stored.artifact.to_bytes() == correction.to_bytes()
+
+
+def test_get_raises_key_error_for_an_unknown_run(tmp_path) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(KeyError) as error:
+            store.get("unknown-run")
+
+    assert error.value.args == ("unknown-run",)
+
