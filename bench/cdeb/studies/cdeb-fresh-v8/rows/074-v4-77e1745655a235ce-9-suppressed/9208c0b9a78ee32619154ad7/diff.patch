@@ -75,17 +76,182 @@ class FileEvidenceReader:
             basis,
         )
 
-    def _manifest(self, files: FetchedFiles) -> str:
-        return "\n".join(
-            text.lower()
-            for path, text in files.files
-            if path.rsplit("/", 1)[-1] in {"package.json", "pyproject.toml", "Cargo.toml", "go.mod", "requirements.txt"}
-        )
+    def _declared_manifest_entries(self, files: FetchedFiles) -> frozenset[str]:
+        """Return normalized dependency and configuration names, never prose."""
+        entries: set[str] = set()
+        for path, text in files.files:
+            name = path.rsplit("/", 1)[-1]
+            if name == "package.json":
+                entries.update(_package_json_entries(text))
+            elif name in {"pyproject.toml", "Cargo.toml"}:
+                entries.update(_toml_entries(text, name))
+            elif name == "go.mod":
+                entries.update(_go_mod_entries(text))
+            elif name == "requirements.txt":
+                entries.update(_requirement_entries(text))
+        return frozenset(entries)
 
     def _producer_name(self, producer) -> str:
         return producer.__name__.removeprefix("_")
 
 
+def _normalized_entry_name(name: str) -> str:
+    """Use the dependency-name normalization shared by manifest formats."""
+    return re.sub(r"[-_.]+", "-", name.strip().lower())
+
+
+def _package_json_entries(text: str) -> set[str]:
+    try:
+        manifest = json.loads(text)
+    except json.JSONDecodeError:
+        return set()
+    if not isinstance(manifest, dict):
+        return set()
+
+    entries: set[str] = set()
+    for field in (
+        "dependencies",
+        "devDependencies",
+        "optionalDependencies",
+        "peerDependencies",
+        "bundledDependencies",
+        "bundleDependencies",
+        "overrides",
+        "config",
+    ):
+        declared = manifest.get(field)
+        if isinstance(declared, dict):
+            entries.update(_normalized_entry_name(name) for name in declared)
+        elif field in {"bundledDependencies", "bundleDependencies"} and isinstance(declared, list):
+            entries.update(_normalized_entry_name(name) for name in declared if isinstance(name, str))
+    return entries
+
+
+_TOML_TABLE = re.compile(r"^\s*\[\[?\s*([^]\s]+(?:\s*\.\s*[^]\s]+)*)\s*\]?\]\s*$")
+_TOML_KEY = re.compile(r'^\s*(?:"([^"]+)"|\'([^\']+)\'|([A-Za-z0-9_-]+))\s*=')
+
+
+def _toml_entries(text: str, manifest_name: str) -> set[str]:
+    """Read names from TOML dependency/configuration entries without TOML values."""
+    entries: set[str] = set()
+    table: tuple[str, ...] = ()
+    dependency_list: list[str] | None = None
+    dependency_list_depth = 0
+    for raw_line in text.splitlines():
+        line = _toml_without_comment(raw_line).strip()
+        if not line:
+            continue
+        if dependency_list is not None:
+            dependency_list.append(line)
+            dependency_list_depth += _toml_array_bracket_balance(line)
+            if dependency_list_depth == 0:
+                entries.update(_toml_requirement_values("\n".join(dependency_list)))
+                dependency_list = None
+            continue
+        table_match = _TOML_TABLE.match(line)
+        if table_match:
+            table = tuple(_toml_path_part(part) for part in table_match.group(1).split("."))
+            if _toml_configuration_table(table, manifest_name):
+                entries.add(_normalized_entry_name(table[-1]))
+            continue
+        key_match = _TOML_KEY.match(line)
+        if not key_match:
+            continue
+        key = next(part for part in key_match.groups() if part is not None)
+        if _toml_dependency_table(table) or _toml_configuration_table(table, manifest_name):
+            entries.add(_normalized_entry_name(key))
+        if _toml_dependency_list(table, key):
+            value = line.split("=", 1)[1]
+            dependency_list_depth = _toml_array_bracket_balance(value)
+            if dependency_list_depth > 0:
+                dependency_list = [value]
+            else:
+                entries.update(_toml_requirement_values(value))
+    return entries
+
+
+def _toml_without_comment(line: str) -> str:
+    quote: str | None = None
+    for index, char in enumerate(line):
+        if char in {"'", '"'}:
+            quote = None if quote == char else char if quote is None else quote
+        elif char == "#" and quote is None:
+            return line[:index]
+    return line
+
+
+def _toml_array_bracket_balance(value: str) -> int:
+    quote: str | None = None
+    balance = 0
+    for char in value:
+        if char in {"'", '"'}:
+            quote = None if quote == char else char if quote is None else quote
+        elif quote is None:
+            balance += (char == "[") - (char == "]")
+    return balance
+
+
+def _toml_path_part(part: str) -> str:
+    return part.strip().strip('"\'')
+
+
+def _toml_dependency_table(table: tuple[str, ...]) -> bool:
+    return bool(table) and table[-1] in {"dependencies", "dev-dependencies", "build-dependencies"}
+
+
+def _toml_configuration_table(table: tuple[str, ...], manifest_name: str) -> bool:
+    if manifest_name == "pyproject.toml":
+        return len(table) >= 2 and table[0] == "tool"
+    return len(table) >= 2 and table[:2] == ("package", "metadata")
+
+
+def _toml_dependency_list(table: tuple[str, ...], key: str) -> bool:
+    return (
+        (table == ("project",) and key == "dependencies")
+        or table == ("project", "optional-dependencies")
+        or (table == ("build-system",) and key == "requires")
+    )
+
+
+def _go_mod_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    in_require = False
+    for raw_line in text.splitlines():
+        line = raw_line.split("//", 1)[0].strip()
+        if not line:
+            continue
+        if line == "require (":
+            in_require = True
+            continue
+        if in_require and line == ")":
+            in_require = False
+            continue
+        if line.startswith("require "):
+            line = line.removeprefix("require ").strip()
+        elif not in_require:
+            continue
+        dependency = line.split(maxsplit=1)[0]
+        entries.add(_normalized_entry_name(dependency))
+    return entries
+
+
+def _requirement_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    for raw_line in text.splitlines():
+        line = raw_line.split("#", 1)[0].strip()
+        if not line or line.startswith(("-", "#")):
+            continue
+        match = re.match(r"([A-Za-z0-9][A-Za-z0-9_.-]*)", line)
+        if match:
+            entries.add(_normalized_entry_name(match.group(1)))
+    return entries
+
+
+def _toml_requirement_values(value: str) -> set[str]:
+    quoted = re.findall(r'["\']([^"\']+)["\']', value)
+    return _requirement_entries("\n".join(quoted)) if quoted else _requirement_entries(value)
+
+
 DEFAULT_EVIDENCE_READER: Final = FileEvidenceReader()
 
 
