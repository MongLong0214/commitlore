@@ -172,3 +172,67 @@ def test_same_version_packs_keep_distinct_identities() -> None:
 
     assert mcp.pack != local_ai.pack
     assert (mcp.pack.name, mcp.pack.version) == ("mcp", "v1")
+
+
+@pytest.mark.parametrize(
+    ("path", "manifest"),
+    (
+        ("package.json", '{"description": "mcp and ollama", "dependencies": {"MCP": "1"}, "config": {"ollama": true}}'),
+        ("pyproject.toml", '[project]\ndescription = "mcp and ollama"\ndependencies = [\n  "MCP>=1",\n  "ollama[cli]>=1",\n]'),
+        ("Cargo.toml", '[package]\ndescription = "mcp and ollama"\n[dependencies]\nMCP = "1"\nollama = "1"'),
+        ("go.mod", '// mcp and ollama\nrequire (\n  MCP v1.0.0\n  ollama v1.0.0\n)'),
+        ("requirements.txt", '# mcp and ollama\nMCP>=1\nollama[cli]>=1'),
+    ),
+)
+def test_manifest_signals_come_from_exact_normalized_declared_entries(path: str, manifest: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, manifest),)),
+        None,
+    )
+
+    by_name = {item.evidence: item for item in evidence}
+    assert by_name["manifest_entries"].values == frozenset({"mcp"})
+    assert by_name["dependencies"].values == frozenset({"ollama"})
+
+
+@pytest.mark.parametrize(
+    ("path", "manifest"),
+    (
+        ("package.json", '{"description": "mcp and ollama", "dependencies": {"mcp-tools": "1", "ollama-client": "1"}}'),
+        ("pyproject.toml", '# mcp and ollama\n[project]\ndescription = "mcp and ollama"\ndependencies = ["mcp-tools", "ollama-client"]'),
+        ("Cargo.toml", '# mcp and ollama\n[package]\ndescription = "mcp and ollama"\n[dependencies]\nmcp-tools = "1"\nollama-client = "1"'),
+        ("go.mod", '// mcp and ollama\nmodule mcp-tools\nrequire ollama-client v1.0.0'),
+        ("requirements.txt", '# mcp and ollama\nmcp-tools>=1\nollama-client>=1'),
+    ),
+)
+def test_manifest_prose_and_longer_entry_names_do_not_produce_category_signals(path: str, manifest: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
