+    assert by_name["dependencies"].values == frozenset()
+
+
+@pytest.mark.parametrize(
+    ("path", "manifest"),
+    (
+        ("package.json", '{"config": {"mcp": true, "ollama": true}}'),
+        ("pyproject.toml", "[tool.category]\nmcp = true\nollama = true"),
+        ("Cargo.toml", "[package.metadata.category]\nmcp = true\nollama = true"),
+    ),
+)
+def test_manifest_configuration_entry_names_are_category_evidence(path: str, manifest: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, manifest),)),
+        None,
+    )
+
+    by_name = {item.evidence: item for item in evidence}
+    assert by_name["manifest_entries"].values == frozenset({"mcp"})
+    assert by_name["dependencies"].values == frozenset({"ollama"})
