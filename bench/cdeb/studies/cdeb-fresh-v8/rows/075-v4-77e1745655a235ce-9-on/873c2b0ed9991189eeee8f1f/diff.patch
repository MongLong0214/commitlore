+    def _manifest_entries_in(self, files: FetchedFiles) -> frozenset[str]:
+        entries: set[str] = set()
+        for path, text in files.files:
+            name = path.rsplit("/", 1)[-1]
+            if name == "package.json":
+                entries.update(_package_entries(text))
+            elif name == "pyproject.toml":
+                entries.update(_pyproject_entries(text))
+            elif name == "Cargo.toml":
+                entries.update(_cargo_entries(text))
+            elif name == "go.mod":
+                entries.update(_go_entries(text))
+            elif name == "requirements.txt":
+                entries.update(_requirement_entries(text))
+        return frozenset(entries)
 
     def _producer_name(self, producer) -> str:
         return producer.__name__.removeprefix("_")
 
 
+_ENTRY_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*")
+_TOML_KEY = re.compile(r"^\s*(?:\"([^\"]+)\"|'([^']+)'|([A-Za-z0-9_-]+))\s*=")
+_TOML_TABLE = re.compile(r"^\s*\[([^]]+)]\s*(?:#.*)?$")
+
+
+def _normalized_entry(name: str) -> str:
+    """Normalize package-style names before checking the fixed evidence values."""
+    return re.sub(r"[-_.]+", "-", name.strip().casefold())
+
+
+def _package_entries(text: str) -> set[str]:
+    try:
+        manifest = json.loads(text)
+    except json.JSONDecodeError:
+        return set()
+    if not isinstance(manifest, dict):
+        return set()
+
+    entries: set[str] = set()
+    for field in ("dependencies", "devDependencies", "optionalDependencies", "peerDependencies", "config"):
+        values = manifest.get(field)
+        if isinstance(values, dict):
+            entries.update(_normalized_entry(key) for key in values)
+    for field in ("bundleDependencies", "bundledDependencies"):
+        values = manifest.get(field)
+        if isinstance(values, list):
+            entries.update(_normalized_entry(value) for value in values if isinstance(value, str))
+    return entries
+
+
+def _pyproject_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    table = ""
+    collecting_dependencies = False
+
+    for raw_line in text.splitlines():
+        line = raw_line.strip()
+        if not line or line.startswith("#"):
+            continue
+        table_match = _TOML_TABLE.match(line)
+        if table_match:
+            table = table_match.group(1).strip().casefold()
+            collecting_dependencies = False
+            if table.startswith("tool."):
+                entries.add(_normalized_entry(table.split(".")[1].strip('\\\"\'')))
+            continue
+
+        key_match = _TOML_KEY.match(line)
+        key = _normalized_entry(next(group for group in key_match.groups() if group is not None)) if key_match else ""
+        is_dependency_table = table == "project.optional-dependencies" or table.endswith(".dependencies")
+        is_dependency_list = table in {"project", "build-system"} and key in {"dependencies", "requires"}
+        is_configuration_table = (
+            table.startswith("tool.")
+            or table == "project.scripts"
+            or table.startswith("project.entry-points.")
+        )
+        if is_dependency_table or is_configuration_table:
+            if key:
+                entries.add(key)
+        if is_dependency_list:
+            collecting_dependencies = "[" in line
+            entries.update(_quoted_requirement_names(line))
+        elif collecting_dependencies:
+            entries.update(_quoted_requirement_names(line))
+        if collecting_dependencies and "]" in line:
+            collecting_dependencies = False
+    return entries
+
+
+def _cargo_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    table = ""
+    dependency_tables = {"dependencies", "dev-dependencies", "build-dependencies", "workspace.dependencies"}
+
+    for raw_line in text.splitlines():
+        line = raw_line.strip()
+        if not line or line.startswith("#"):
+            continue
+        table_match = _TOML_TABLE.match(line)
+        if table_match:
+            table = table_match.group(1).strip().casefold()
+            continue
+        key_match = _TOML_KEY.match(line)
+        if not key_match:
+            continue
+        key = _normalized_entry(next(group for group in key_match.groups() if group is not None))
+        if table in dependency_tables or table.endswith(".dependencies") or table == "features":
+            entries.add(key)
+    return entries
+
+
+def _go_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    entry_directive = ""
+    for raw_line in text.splitlines():
+        line = raw_line.split("//", 1)[0].strip()
+        if not line:
+            continue
+        if line == ")":
+            entry_directive = ""
+            continue
+        directive = next(
+            (name for name in ("require", "replace", "exclude") if line.startswith(f"{name} ")),
+            None,
+        )
+        if directive:
+            value = line[len(directive) :].strip()
+            if value == "(":
+                entry_directive = directive
+            else:
+                entries.add(_normalized_entry(value.split()[0]))
+            continue
+        if entry_directive:
+            entries.add(_normalized_entry(line.split()[0]))
+    return entries
+
+
+def _requirement_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    for raw_line in text.splitlines():
+        line = raw_line.split("#", 1)[0].strip()
+        if not line or line.startswith(("-", "--")):
+            continue
+        match = _ENTRY_NAME.match(line)
+        if match:
+            entries.add(_normalized_entry(match.group(0)))
+    return entries
+
+
+def _quoted_requirement_names(line: str) -> set[str]:
+    return {
+        _normalized_entry(match.group(1))
+        for match in re.finditer(r"[\"']([A-Za-z0-9][A-Za-z0-9._-]*)", line)
+    }
+
+
 DEFAULT_EVIDENCE_READER: Final = FileEvidenceReader()
 
 
