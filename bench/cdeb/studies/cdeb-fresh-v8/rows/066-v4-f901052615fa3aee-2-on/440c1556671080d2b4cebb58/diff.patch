+def test_history_limit_returns_recent_persisted_artifacts_in_append_order(
+    tmp_path,
+) -> None:
+    # Given: three complete artifacts were appended to the durable store.
+    recorded = (
+        artifact(stars=4),
+        artifact(stars=7),
+        artifact(stars=9),
+    )
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for number, value in enumerate(recorded, start=1):
+            store.save(f"run-{number}", value)
+
+        # When: callers request only the two most recently appended runs.
+        recent = store.history(limit=2)
+        complete = store.history()
+
+    # Then: the slice retains append order and the stored artifacts are unchanged.
+    assert [run.run_id for run in recent] == ["run-2", "run-3"]
+    assert [run.artifact.to_bytes() for run in recent] == [
+        recorded[1].to_bytes(),
+        recorded[2].to_bytes(),
+    ]
+    assert [run.run_id for run in complete] == ["run-1", "run-2", "run-3"]
+
+
+def test_observations_limit_returns_recent_derived_records_in_append_order(
+    tmp_path,
+) -> None:
+    # Given: three runs recorded observations at distinct times and star counts.
+    observed_at = (
+        AT,
+        datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc),
+        datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc),
+    )
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for number, (at, stars) in enumerate(zip(observed_at, (4, 7, 9)), start=1):
+            store.save(f"run-{number}", artifact(at=at, stars=stars))
+
+        # When: callers request the two latest derived observations.
+        recent = store.observations(limit=2)
+        complete = store.observations()
+
+    # Then: their existing values are retained in chronological append order.
+    assert recent == (
+        StoredObservation("run-2", "org/repo", observed_at[1], 7),
+        StoredObservation("run-3", "org/repo", observed_at[2], 9),
+    )
+    assert [observation.run_id for observation in complete] == [
+        "run-1",
+        "run-2",
+        "run-3",
+    ]
+
+
+@pytest.mark.parametrize("method", ("history", "observations"))
+@pytest.mark.parametrize("limit", (0, -1))
+def test_store_read_limits_must_be_positive(tmp_path, method, limit) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(ValueError, match="limit must be positive"):
+            getattr(store, method)(limit=limit)
+
+
