@@ -172,3 +172,66 @@ def test_same_version_packs_keep_distinct_identities() -> None:
 
     assert mcp.pack != local_ai.pack
     assert (mcp.pack.name, mcp.pack.version) == ("mcp", "v1")
+
+
+@pytest.mark.parametrize(
+    ("path", "contents"),
+    (
+        ("package.json", '{"dependencies": {"MCP": "1", "Ollama": "1"}}'),
+        ("pyproject.toml", '[project]\ndependencies = [\n  "MCP>=1",\n  "Ollama>=1",\n]'),
+        ("Cargo.toml", '[dependencies]\nMCP = "1"\nOllama = "1"'),
+        ("go.mod", "module example.com/project\n\nrequire (\n  MCP v1.0.0\n  Ollama v1.0.0\n)"),
+        ("requirements.txt", "MCP>=1\nOllama>=1"),
+    ),
+)
+def test_manifest_categories_use_exact_normalized_declared_entries(path: str, contents: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, contents),)),
+        None,
+    )
+
+    assert next(item for item in evidence if item.evidence == "manifest_entries").values == frozenset({"mcp"})
+    assert next(item for item in evidence if item.evidence == "dependencies").values == frozenset({"ollama"})
+    assert classify(CATEGORY_PACKS[1], evidence).category == "mcp"
+    assert classify(CATEGORY_PACKS[2], evidence).category == "local-ai"
+
+
+@pytest.mark.parametrize(
+    ("path", "contents"),
+    (
+        ("package.json", '{"description": "mcp and ollama", "dependencies": {"mcp-tools": "1", "ollama-client": "1"}}'),
+        ("pyproject.toml", '# mcp and ollama\n[project]\ndescription = "mcp ollama"\ndependencies = ["mcp-tools", "ollama-client"]'),
+        ("Cargo.toml", '# mcp and ollama\n[package]\ndescription = "mcp ollama"\n[dependencies]\nmcp-tools = "1"\nollama-client = "1"'),
+        ("go.mod", "// mcp and ollama\nrequire (\n  mcp-tools v1.0.0\n  ollama-client v1.0.0\n)"),
+        ("requirements.txt", "# mcp and ollama\nmcp-tools>=1\nollama-client>=1"),
+    ),
+)
+def test_manifest_categories_ignore_prose_and_longer_entry_names(path: str, contents: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, contents),)),
+        None,
+    )
+
+    assert next(item for item in evidence if item.evidence == "manifest_entries").values == frozenset()
+    assert next(item for item in evidence if item.evidence == "dependencies").values == frozenset()
+
+
+@pytest.mark.parametrize(
+    ("path", "contents"),
+    (
+        ("package.json", '{"config": {"mcp": true, "ollama": true}}'),
+        ("pyproject.toml", "[project.scripts]\nmcp = 'pkg:main'\nollama = 'pkg:serve'"),
+        ("Cargo.toml", "[features]\nmcp = []\nollama = []"),
+    ),
+)
+def test_manifest_categories_accept_exact_configuration_entry_names(path: str, contents: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, contents),)),
+        None,
+    )
+
+    assert next(item for item in evidence if item.evidence == "manifest_entries").values == frozenset({"mcp"})
+    assert next(item for item in evidence if item.evidence == "dependencies").values == frozenset({"ollama"})
