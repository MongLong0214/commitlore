+def test_history_and_observations_return_a_recent_chronological_slice(tmp_path) -> None:
+    # Given: three persisted artifacts and their derived observations were appended.
+    middle_at = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    latest_at = datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc)
+    first = artifact(stars=4, at=AT)
+    middle = artifact(stars=6, at=middle_at)
+    latest = artifact(stars=9, at=latest_at)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", first)
+        store.save("middle", middle)
+        store.save("latest", latest)
+
+        # When: callers request all records and the two most recent records.
+        history = store.history()
+        recent_history = store.history(limit=2)
+        observations = store.observations()
+        recent_observations = store.observations(limit=2)
+
+    # Then: complete reads retain append order and slices retain values and chronology.
+    assert [(record.run_id, record.artifact.to_bytes()) for record in history] == [
+        ("first", first.to_bytes()),
+        ("middle", middle.to_bytes()),
+        ("latest", latest.to_bytes()),
+    ]
+    assert [(record.run_id, record.artifact.to_bytes()) for record in recent_history] == [
+        ("middle", middle.to_bytes()),
+        ("latest", latest.to_bytes()),
+    ]
+    assert [(record.run_id, record.observed_at, record.stars) for record in observations] == [
+        ("first", AT, 4),
+        ("middle", middle_at, 6),
+        ("latest", latest_at, 9),
+    ]
+    assert [(record.run_id, record.observed_at, record.stars) for record in recent_observations] == [
+        ("middle", middle_at, 6),
+        ("latest", latest_at, 9),
+    ]
+
+
+@pytest.mark.parametrize("method", ["history", "observations"])
+def test_history_and_observations_reject_nonpositive_limits(tmp_path, method: str) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(ValueError, match="limit must be positive"):
+            getattr(store, method)(limit=0)
+
+
