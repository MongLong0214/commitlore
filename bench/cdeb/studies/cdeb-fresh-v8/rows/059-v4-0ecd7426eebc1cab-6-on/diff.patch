diff --git a/tests/test_seam.py b/tests/test_seam.py
index cc155de..a8e5679 100644
--- a/tests/test_seam.py
+++ b/tests/test_seam.py
@@ -381,3 +381,92 @@ def test_broken_category_reader_does_not_change_the_approval_inputs() -> None:
     assert artifact.scores[0].recommendation.status.value == "review"
     assert artifact.repositories[0].categories[0].basis is ClaimBasis.ABSENT
     assert any(failure.port == "category" for failure in artifact.failures)
+
+
+def test_unsupported_category_pack_fails_before_any_operational_port_is_called() -> None:
+    calls: list[str] = []
+
+    class TrackingRepository(Repository):
+        def search(self, query: str, limit: int) -> CollectResult:
+            calls.append("repository.search")
+            return super().search(query, limit)
+
+    class TrackingFiles(Files):
+        def read(self, candidate: Candidate) -> FetchedFiles:
+            calls.append("files.read")
+            return super().read(candidate)
+
+    class TrackingModel(Model):
+        def evaluate(self, digest: str) -> GradeResult:
+            calls.append("model.evaluate")
+            return super().evaluate(digest)
+
+    class TrackingClock(Clock):
+        def now(self) -> datetime:
+            calls.append("clock.now")
+            return super().now()
+
+    class IncompleteEvidence:
+        evidence_names = frozenset({"files"})
+
+        def read_evidence(self, candidate, files, metadata):
+            calls.append("evidence.read_evidence")
+            return ()
+
+    with pytest.raises(ValueError, match="category pack 'coding-agents'.*source"):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(
+                TrackingRepository(),
+                TrackingFiles(),
+                TrackingModel(),
+                TrackingClock(),
+                IncompleteEvidence(),
+            ),
+        )
+
+    assert calls == []
+
+
+def test_category_absence_uses_the_configured_reader_vocabulary_after_files_fail() -> None:
+    class CustomEvidence:
+        evidence_names = frozenset({"files", "source", "custom"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("file failures must not call the evidence reader")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(
+            Repository(),
+            Files(OSError("offline")),
+            Model(),
+            Clock(),
+            CustomEvidence(),
+        ),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+
+    evidence = artifact.repositories[0].category_evidence
+    assert {item.evidence for item in evidence} == {"files", "source", "custom"}
+    assert all(item.values == frozenset() and item.basis is ClaimBasis.ABSENT for item in evidence)
+    assert artifact.repositories[0].categories[0].basis is ClaimBasis.ABSENT
+
+
+def test_category_absence_uses_the_configured_reader_vocabulary_after_evidence_fails() -> None:
+    class BrokenCustomEvidence:
+        evidence_names = frozenset({"files", "source", "custom"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise RuntimeError("custom reader unavailable")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(Repository(), Files(), Model(), Clock(), BrokenCustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+
+    evidence = artifact.repositories[0].category_evidence
+    assert {item.evidence for item in evidence} == {"files", "source", "custom"}
+    assert all(item.values == frozenset() and item.basis is ClaimBasis.ABSENT for item in evidence)
+    assert artifact.repositories[0].categories[0].basis is ClaimBasis.ABSENT
