+def test_observations_sort_by_recorded_time_and_retain_equal_time_sequence(tmp_path) -> None:
+    # Given: a newer observation is saved before two observations at the same older time.
+    later = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("newer", artifact(stars=9, at=later))
+        store.save("older-first", artifact(stars=4, at=AT))
+        store.save("older-second", artifact(stars=5, at=AT))
+
+        # When: observations are read after runs were saved out of timestamp order.
+        observations = store.observations()
+
+    # Then: recorded time orders history, and equal times retain recording sequence.
+    assert [(observation.run_id, observation.observed_at, observation.stars) for observation in observations] == [
+        ("older-first", AT, 4),
+        ("older-second", AT, 5),
+        ("newer", later, 9),
+    ]
+
+
