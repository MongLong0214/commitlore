+def test_observations_limit_returns_the_recent_append_slice_in_chronological_order(tmp_path) -> None:
+    # Given: three saved artifacts each derived one repository observation.
+    observed_at = (
+        AT,
+        datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc),
+        datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc),
+    )
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for index, (at, stars) in enumerate(zip(observed_at, (4, 7, 11)), start=1):
+            store.save(f"run-{index}", artifact(stars=stars, at=at))
+
+        # When: callers request the two most recently appended observations.
+        recent = store.observations(limit=2)
+        complete = store.observations()
+
+    # Then: the derived values and chronological append order survive the slice.
+    assert recent == (
+        StoredObservation("run-2", CANDIDATE.repo, observed_at[1], 7),
+        StoredObservation("run-3", CANDIDATE.repo, observed_at[2], 11),
+    )
+    assert [observation.run_id for observation in complete] == ["run-1", "run-2", "run-3"]
+
+
