+def test_history_limit_returns_the_recent_append_slice_in_chronological_order(tmp_path) -> None:
+    # Given: three persisted run artifacts were appended in order.
+    recorded = (
+        artifact(stars=4),
+        artifact(stars=7),
+        artifact(stars=11),
+    )
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for index, value in enumerate(recorded, start=1):
+            store.save(f"run-{index}", value)
+
+        # When: callers request the two most recently appended runs.
+        recent = store.history(limit=2)
+        complete = store.history()
+
+    # Then: the slice retains append order and complete reads remain unchanged.
+    assert [run.run_id for run in recent] == ["run-2", "run-3"]
+    assert [run.artifact.to_bytes() for run in recent] == [
+        recorded[1].to_bytes(),
+        recorded[2].to_bytes(),
+    ]
+    assert [run.run_id for run in complete] == ["run-1", "run-2", "run-3"]
+
