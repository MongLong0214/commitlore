+
+        assert transport.urls == []
+
+    @pytest.mark.parametrize("per_page", [1, 100])
+    def test_github_per_page_boundaries_are_accepted(self, per_page: int) -> None:
+        transport = FakeTransport([(200, OK, page([]))])
+
+        result = collect("q", transport=transport, per_page=per_page)
+
+        assert result.pages_fetched == 1
