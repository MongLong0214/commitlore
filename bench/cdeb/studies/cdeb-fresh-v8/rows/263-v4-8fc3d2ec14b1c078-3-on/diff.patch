+            {"per_page": 0},
+            {"per_page": -1},
+            {"per_page": 101},
+        ],
+    )
+    def test_invalid_paging_is_rejected_before_contacting_the_transport(
+        self, paging: dict[str, int]
+    ) -> None:
+        transport = FakeTransport([(200, OK, page([]))])
+
+        with pytest.raises(ValueError):
