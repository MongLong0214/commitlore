+def test_observations_are_ordered_by_time_with_recording_sequence_ties(tmp_path) -> None:
+    # Given: a newer observation is saved before two observations at an older time.
+    earlier = datetime(2026, 7, 26, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("newer", artifact(stars=9, at=AT))
+        store.save("older-first", artifact(stars=4, at=earlier))
+
+        # When: another observation with that older recorded time is saved.
+        store.save("older-second", artifact(stars=5, at=earlier))
+        observations = store.observations()
+
+    # Then: time determines the result order and equal timestamps retain save order.
+    assert [observation.run_id for observation in observations] == [
+        "older-first",
+        "older-second",
+        "newer",
+    ]
+
+
