+def test_point_lookup_returns_a_correction_and_its_lineage(tmp_path) -> None:
+    # Given: an immutable correction points at an earlier stored run.
+    correction = artifact()
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("original", artifact(Files(OSError("offline"))))
+        store.save("correction", correction, corrects_run_id="original")
+
+        # When: a known correction is retrieved directly.
+        stored = store.get("correction")
+
+        # Then: it returns the correction itself and its correction lineage.
+        assert stored.run_id == "correction"
+        assert stored.corrects_run_id == "original"
+        assert stored.artifact.to_bytes() == correction.to_bytes()
+
+
+def test_point_lookup_of_an_unknown_run_raises_its_identifier(tmp_path) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(KeyError) as error:
+            store.get("missing-run")
+
+    assert error.value.args == ("missing-run",)
+
+
