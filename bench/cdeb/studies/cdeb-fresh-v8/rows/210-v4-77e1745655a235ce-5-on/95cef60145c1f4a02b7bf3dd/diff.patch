+def _normalized_entry_name(name: str) -> str:
+    """Normalize a dependency or configuration entry name, not manifest prose."""
+    return re.sub(r"[-_.]+", "-", name).casefold()
+
+
+def _json_entry_names(text: str) -> set[str]:
+    try:
+        document = json.loads(text)
+    except json.JSONDecodeError:
+        return set()
+    return _mapping_entry_names(document)
+
+
+def _mapping_entry_names(value: object) -> set[str]:
+    if not isinstance(value, dict):
+        return set()
+    names = {_normalized_entry_name(str(name)) for name in value}
+    for child in value.values():
+        names.update(_mapping_entry_names(child))
+    return names
+
+
+def _toml_entry_names(text: str) -> set[str]:
+    contents = _without_toml_comments(text)
+    names = {
+        _normalized_entry_name(match.group(1) or match.group(2) or match.group(3))
+        for match in re.finditer(r'^\s*(?:([A-Za-z0-9_-]+)|"([^"]+)"|\'([^\']+)\')\s*=', contents, re.MULTILINE)
+    }
+    names.update(
+        _normalized_entry_name(part)
+        for match in re.finditer(r'^\s*\[\[?\s*([^]\s]+).*?\]\]?\s*$', contents, re.MULTILINE)
+        for part in match.group(1).split('.')
+    )
+    for match in re.finditer(r'^\s*dependencies\s*=\s*\[(.*?)\]', contents, re.MULTILINE | re.DOTALL):
+        names.update(_requirement_entry_names("\n".join(re.findall(r'["\']([^"\']+)["\']', match.group(1)))))
+    return names
+
+
+def _without_toml_comments(text: str) -> str:
+    lines = []
+    for line in text.splitlines():
+        quote = None
+        escaped = False
+        kept = []
+        for character in line:
+            if quote == '"' and character == "\\" and not escaped:
+                escaped = True
+                kept.append(character)
+                continue
+            if character in {"'", '"'} and not escaped:
+                quote = None if quote == character else character if quote is None else quote
+            if character == "#" and quote is None:
+                break
+            kept.append(character)
+            escaped = False
+        lines.append("".join(kept))
+    return "\n".join(lines)
+
+
+def _go_mod_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    in_require_block = False
+    for raw_line in re.sub(r"/\\*.*?\\*/", "", text, flags=re.DOTALL).splitlines():
+        line = raw_line.split("//", 1)[0].strip()
+        if not line:
+            continue
+        if line == ")":
+            in_require_block = False
+            continue
+        if line.startswith("require (") or line == "require(":
+            in_require_block = True
+            continue
+        if line.startswith("require "):
+            entry = line.removeprefix("require ").split(None, 1)[0]
+            names.add(_normalized_entry_name(entry))
+        elif in_require_block:
+            names.add(_normalized_entry_name(line.split(None, 1)[0]))
+    return names
+
+
+def _requirement_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    for raw_line in text.splitlines():
+        line = raw_line.split("#", 1)[0].strip()
+        match = re.match(r"([A-Za-z0-9][A-Za-z0-9._-]*)", line)
+        if match and not line.startswith("-"):
+            names.add(_normalized_entry_name(match.group(1)))
+    return names
