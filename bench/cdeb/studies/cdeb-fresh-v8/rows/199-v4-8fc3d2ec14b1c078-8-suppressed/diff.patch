 class TestPaging:
+    @pytest.mark.parametrize(
+        ("argument", "value", "message"),
+        [
+            ("pages", 0, "pages must be at least 1"),
+            ("pages", -1, "pages must be at least 1"),
+            ("per_page", 0, "per_page must be between 1 and 100"),
+            ("per_page", -1, "per_page must be between 1 and 100"),
+            ("per_page", 101, "per_page must be between 1 and 100"),
+        ],
+    )
+    def test_invalid_paging_arguments_raise_before_contacting_transport(
+        self, argument: str, value: int, message: str
+    ) -> None:
+        transport = FakeTransport([(200, OK, page([]))])
+
+        with pytest.raises(ValueError, match=message):
+            collect("q", transport=transport, **{argument: value})
+
+        assert transport.urls == []
+
+    @pytest.mark.parametrize("per_page", [1, 100])
+    def test_supported_per_page_boundaries_are_accepted(self, per_page: int) -> None:
+        transport = FakeTransport([(200, OK, page([]))])
+
+        collect("q", transport=transport, per_page=per_page)
+
+        assert parse_qs(urlparse(transport.urls[0]).query)["per_page"] == [str(per_page)]
+
