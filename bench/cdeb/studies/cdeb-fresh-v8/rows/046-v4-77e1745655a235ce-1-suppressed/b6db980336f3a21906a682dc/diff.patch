@@ -172,3 +173,82 @@ def test_same_version_packs_keep_distinct_identities() -> None:
 
     assert mcp.pack != local_ai.pack
     assert (mcp.pack.name, mcp.pack.version) == ("mcp", "v1")
+
+
+@pytest.mark.parametrize(
+    ("path", "contents"),
+    (
+        ("package.json", json.dumps({"dependencies": {"MCP": "1", "Ollama": "1"}})),
+        ("pyproject.toml", '[project]\ndependencies = ["MCP>=1", "Ollama == 1"]\n'),
+        ("Cargo.toml", '[dependencies]\nMCP = "1"\nOllama = "1"\n'),
+        ("go.mod", "module example.test/demo\n\nrequire (\n\tmcp v1.0.0\n\tollama v1.0.0\n)\n"),
+        ("requirements.txt", "MCP>=1\nOllama == 1\n"),
+    ),
+)
+def test_manifest_declarations_produce_category_signals(path: str, contents: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, contents),)),
+        None,
+    )
+
+    assert next(item for item in evidence if item.evidence == "manifest_entries").values == frozenset({"mcp"})
+    assert next(item for item in evidence if item.evidence == "dependencies").values == frozenset({"ollama"})
+
+
+@pytest.mark.parametrize(
+    ("path", "contents"),
