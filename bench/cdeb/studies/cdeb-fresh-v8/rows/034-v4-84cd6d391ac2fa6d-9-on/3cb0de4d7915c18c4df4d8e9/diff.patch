+def test_point_lookup_returns_a_correction_and_its_lineage(tmp_path) -> None:
+    # Given: an immutable correction references an earlier stored run.
+    corrected = artifact(Files(OSError("offline")))
+    correction = artifact()
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("run-1", corrected)
+        store.save("run-2", correction, corrects_run_id="run-1")
+
+        # When: the correction is retrieved by its known identifier.
+        stored = store.get("run-2")
+
+    # Then: it returns the correction itself and the run it corrects.
+    assert stored.run_id == "run-2"
+    assert stored.corrects_run_id == "run-1"
+    assert stored.artifact.to_bytes() == correction.to_bytes()
+
+
+def test_point_lookup_of_an_unknown_run_identifies_the_missing_id(tmp_path) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(KeyError) as error:
+            store.get("missing-run")
+
+    assert error.value.args == ("missing-run",)
+
