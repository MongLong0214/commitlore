+    def _manifest_entry_names(self, files: FetchedFiles) -> frozenset[str]:
+        """Return normalized names declared by the supported manifest formats."""
+        entries: set[str] = set()
+        for path, text in files.files:
+            manifest = path.rsplit("/", 1)[-1]
+            if manifest == "package.json":
+                entries.update(_package_json_entries(text))
+            elif manifest == "pyproject.toml":
+                entries.update(_toml_entries(text, pyproject=True))
+            elif manifest == "Cargo.toml":
+                entries.update(_toml_entries(text, pyproject=False))
+            elif manifest == "go.mod":
+                entries.update(_go_mod_entries(text))
+            elif manifest == "requirements.txt":
+                entries.update(_requirements_entries(text))
+        return frozenset(entries)
 
     def _producer_name(self, producer) -> str:
         return producer.__name__.removeprefix("_")
 
 
+def _package_json_entries(text: str) -> frozenset[str]:
+    try:
+        manifest = json.loads(text)
+    except (json.JSONDecodeError, TypeError):
+        return frozenset()
+    if not isinstance(manifest, dict):
+        return frozenset()
+
+    entries: set[str] = set()
+    for key in _PACKAGE_DEPENDENCY_KEYS | {"config"}:
+        value = manifest.get(key)
+        if isinstance(value, dict):
+            entries.update(_normalized_entry_name(name) for name in value)
+    bundled = manifest.get("bundledDependencies")
+    if isinstance(bundled, list):
+        entries.update(_normalized_entry_name(value) for value in bundled if isinstance(value, str))
+    return frozenset(entries)
+
+
+def _toml_entries(text: str, *, pyproject: bool) -> frozenset[str]:
+    """Read TOML keys plus Python requirement names without treating prose as entries.
+
+    This deliberately handles only the small TOML surface needed for manifest entry
+    names, keeping Python 3.9 support without a TOML-parser dependency.
+    """
+    entries: set[str] = set()
+    section = ""
+    collecting_dependencies = False
+    bracket_depth = 0
+    for raw_line in text.splitlines():
+        line = _without_toml_comment(raw_line)
+        if collecting_dependencies:
+            entries.update(_toml_requirement_names(line))
+            bracket_depth += _toml_bracket_delta(line)
+            collecting_dependencies = bracket_depth > 0
+            continue
+
+        table = _TOML_TABLE.match(line)
+        if table:
+            section = table.group(1).strip().lower()
+            entries.add(_normalized_entry_name(section.rsplit(".", 1)[-1]))
+            continue
+
+        assignment = _TOML_ASSIGNMENT.match(line)
+        if not assignment:
+            continue
+        key = assignment.group(1)
+        entries.add(_normalized_entry_name(key))
+        value = line[assignment.end() :]
+        dependency_list = pyproject and (
+            (section == "project" and key == "dependencies")
+            or section in {"project.optional-dependencies", "dependency-groups"}
+        )
+        if dependency_list:
+            entries.update(_toml_requirement_names(value))
+            bracket_depth = _toml_bracket_delta(value)
+            collecting_dependencies = bracket_depth > 0
+    return frozenset(entries)
+
+
+def _go_mod_entries(text: str) -> frozenset[str]:
+    entries: set[str] = set()
+    in_require_block = False
+    for raw_line in text.splitlines():
+        line = raw_line.split("//", 1)[0].strip()
+        if not line:
+            continue
+        if in_require_block:
+            if line == ")":
+                in_require_block = False
+            else:
+                entries.add(_normalized_entry_name(line))
+            continue
+        if line.startswith("require ("):
+            in_require_block = True
+        elif line.startswith("require "):
+            entries.add(_normalized_entry_name(line[len("require ") :]))
+    return frozenset(entries)
+
+
+def _requirements_entries(text: str) -> frozenset[str]:
+    entries: set[str] = set()
+    for raw_line in text.splitlines():
+        line = raw_line.split("#", 1)[0].strip()
+        if line and not line.startswith("-"):
+            entries.add(_normalized_entry_name(line))
+    return frozenset(entries)
+
+
+def _toml_requirement_names(value: str) -> frozenset[str]:
+    return frozenset(
+        _normalized_entry_name(match.group(1) or match.group(2))
+        for match in _TOML_STRING.finditer(value)
+    )
+
+
+def _without_toml_comment(line: str) -> str:
+    quote = ""
+    escaped = False
+    for index, character in enumerate(line):
+        if quote:
+            if character == quote and not escaped:
+                quote = ""
+            escaped = character == "\\" and not escaped
+        elif character in {"'", '"'}:
+            quote = character
+        elif character == "#":
+            return line[:index]
+    return line
+
+
+def _toml_bracket_delta(value: str) -> int:
+    without_strings = _TOML_STRING.sub("", value)
+    return without_strings.count("[") - without_strings.count("]")
+
+
+def _normalized_entry_name(value: str) -> str:
+    match = _ENTRY_NAME.match(value)
+    if not match:
+        return ""
+    return re.sub(r"[_.-]+", "-", match.group(1).lower())
+
+
 DEFAULT_EVIDENCE_READER: Final = FileEvidenceReader()
 
 
