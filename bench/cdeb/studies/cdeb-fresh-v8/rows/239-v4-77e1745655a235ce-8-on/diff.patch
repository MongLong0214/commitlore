+_TOML_ASSIGNMENT: Final = re.compile(r"^\s*([A-Za-z0-9_.-]+)\s*=")
+_TOML_STRING: Final = re.compile(r'''(?:(?:"((?:\\.|[^"\\])*)")|(?:'((?:\\.|[^'\\])*)'))''')
+_ENTRY_NAME: Final = re.compile(r"\s*([A-Za-z0-9][A-Za-z0-9_.-]*)")
