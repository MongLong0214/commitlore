+def test_history_limit_returns_recent_artifacts_in_append_order(tmp_path) -> None:
+    # Given: three complete artifacts have been durably appended to the store.
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for run_id, stars in (("first", 4), ("second", 9), ("third", 16)):
+            store.save(run_id, artifact(stars=stars))
+
+        # When: callers ask for the two most recently appended runs.
+        history = store.history(limit=2)
+        complete_history = store.history()
+
+    # Then: their persisted artifacts retain their values and append order.
+    assert [(run.run_id, run.artifact.collection.candidates[0].stars) for run in history] == [
+        ("second", 9),
+        ("third", 16),
+    ]
+    assert [run.run_id for run in complete_history] == ["first", "second", "third"]
+
+
