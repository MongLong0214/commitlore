+def test_observations_are_ordered_by_recorded_time_with_sequence_tiebreaker(tmp_path) -> None:
+    # Given: a newer observation is recorded before backfilled older observations.
+    earlier = datetime(2026, 7, 26, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("newer", artifact(stars=9, at=AT))
+        store.save("older-first", artifact(stars=3, at=earlier))
+        store.save("older-second", artifact(stars=4, at=earlier))
+
+        # When: observation history is read.
+        observations = store.observations()
+
+    # Then: timestamps sort oldest first, with matching times retaining save sequence.
+    assert [(observation.run_id, observation.observed_at, observation.stars) for observation in observations] == [
+        ("older-first", earlier, 3),
+        ("older-second", earlier, 4),
+        ("newer", AT, 9),
+    ]
+
+
