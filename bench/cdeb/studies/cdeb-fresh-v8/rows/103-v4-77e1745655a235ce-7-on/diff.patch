+@pytest.mark.parametrize(
+    ("path", "contents"),
+    (
+        ("package.json", '{"dependencies": {"MCP": "^1"}, "config": {"ollama": true}}'),
+        ("pyproject.toml", '[project]\ndependencies = ["MCP>=1"]\n[tool.runtime]\nollama = true\n'),
+        ("Cargo.toml", '[dependencies]\nmcp = "1"\n[features]\nollama = []\n'),
+        ("go.mod", "module example.test/tool\n\nrequire (\n  mcp v1.0.0\n  ollama v1.0.0\n)\n"),
+        ("requirements.txt", "MCP>=1\nollama[server]>=1\n"),
+    ),
+)
+def test_manifest_evidence_uses_exact_declared_dependency_or_configuration_names(path: str, contents: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, contents),)),
+        None,
+    )
+
+    by_name = {item.evidence: item for item in evidence}
+
+    assert by_name["manifest_entries"].values == frozenset({"mcp"})
+    assert by_name["dependencies"].values == frozenset({"ollama"})
+
+
+@pytest.mark.parametrize(
+    ("path", "contents"),
