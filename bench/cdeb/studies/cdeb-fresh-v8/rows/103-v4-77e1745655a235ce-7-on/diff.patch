+        ("package.json", '{"description": "mcp and ollama", "dependencies": {"mcp-tools": "1", "ollama-client": "1"}}'),
+        ("pyproject.toml", '[project]\ndescription = "mcp and ollama"\ndependencies = ["mcp-tools", "ollama-client"]\n'),
