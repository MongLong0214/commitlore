+    ),
+)
+def test_manifest_evidence_ignores_text_and_longer_entry_names(path: str, contents: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, contents),)),
