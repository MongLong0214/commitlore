+def test_history_limit_returns_the_latest_runs_in_append_order(tmp_path) -> None:
+    # Given: three persisted artifacts were appended to the store.
+    first = artifact(stars=1)
+    second = artifact(stars=2)
+    third = artifact(stars=3)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", first)
+        store.save("second", second, corrects_run_id="first")
+        store.save("third", third, corrects_run_id="second")
+
+        # When: callers request only the two most recently appended runs.
+        history = store.history(limit=2)
+        complete_history = store.history()
+
+    # Then: the retained record values remain chronological within that slice.
+    assert [(run.run_id, run.corrects_run_id, run.artifact.to_bytes()) for run in history] == [
+        ("second", "first", second.to_bytes()),
+        ("third", "second", third.to_bytes()),
+    ]
+    assert [run.run_id for run in complete_history] == ["first", "second", "third"]
+
