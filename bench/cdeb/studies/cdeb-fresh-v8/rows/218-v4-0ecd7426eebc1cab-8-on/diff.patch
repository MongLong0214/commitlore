+
+
+def test_category_pack_requirements_are_checked_before_operational_ports() -> None:
+    calls = []
+
+    class UnsupportedEvidence:
+        evidence_names = frozenset({"files"})
+
+        def read_evidence(self, candidate, files, metadata):
+            calls.append("evidence")
+            return ()
+
+    class OperationalRepository:
+        def search(self, query, limit):
+            calls.append("repository")
+            return CollectResult()
+
+        def metadata(self, candidate, at):
+            calls.append("metadata")
+            return RepositoryMetadata(ScoreInputs(True, True, True))
+
+    class OperationalFiles:
+        def read(self, candidate):
+            calls.append("files")
+            return FetchedFiles(())
+
+    class OperationalModel:
+        def evaluate(self, digest):
+            calls.append("model")
+            return GradeResult(8, 7, "", "", 0.0, "")
+
+        def flags_malicious(self, digest):
+            return False
+
+    class OperationalClock:
+        def now(self):
+            calls.append("clock")
+            return AT
+
+    with pytest.raises(
+        ValueError,
+        match="category pack 'coding-agents' names unavailable evidence: source",
+    ):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(
+                OperationalRepository(),
+                OperationalFiles(),
+                OperationalModel(),
+                OperationalClock(),
+                UnsupportedEvidence(),
+            ),
+        )
+
+    assert calls == []
+
+
+@pytest.mark.parametrize(
+    "files_error, reader_error",
+    [(OSError("unreadable"), None), (None, RuntimeError("unavailable"))],
+)
+def test_category_evidence_absence_uses_the_injected_reader_vocabulary(
+    files_error,
+    reader_error,
+) -> None:
+    class CustomEvidence:
+        evidence_names = frozenset({"files", "manifest_entries", "dependencies", "source", "custom"})
+
+        def read_evidence(self, candidate, files, metadata):
+            if reader_error is not None:
+                raise reader_error
+            return ()
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(Repository(), Files(files_error), Model(), Clock(), CustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+    trace = artifact.repositories[0]
+
+    assert {(item.evidence, item.values, item.basis) for item in trace.category_evidence} == {
+        (name, frozenset(), ClaimBasis.ABSENT)
+        for name in CustomEvidence.evidence_names
+    }
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
