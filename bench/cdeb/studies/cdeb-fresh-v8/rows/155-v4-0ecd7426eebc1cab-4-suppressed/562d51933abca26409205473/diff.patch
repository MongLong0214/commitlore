+def test_unreadable_files_record_absent_evidence_in_the_injected_vocabulary() -> None:
+    class CustomEvidence:
+        evidence_names = frozenset({"files", "source", "custom"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("files were unavailable, so evidence must not be read")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(Repository(), Files(OSError("offline")), Model(), Clock(), CustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+
+    evidence = artifact.repositories[0].category_evidence
+    category = artifact.repositories[0].categories[0]
+    assert {item.evidence for item in evidence} == CustomEvidence.evidence_names
+    assert all(item.values == frozenset() and item.basis is ClaimBasis.ABSENT for item in evidence)
+    assert (category.category, category.basis, category.missing_evidence) == (
+        None,
+        ClaimBasis.ABSENT,
+        ("files", "source"),
+    )
+
+
+def test_unsupported_evidence_fails_before_operational_ports_are_called() -> None:
+    calls: list[str] = []
+
+    class UnsupportedEvidence:
+        evidence_names = frozenset({"files"})
+
+        def read_evidence(self, candidate, files, metadata):
+            calls.append("evidence")
+            raise AssertionError("unsupported evidence should fail during validation")
+
+    class UnusedRepository:
+        def search(self, query, limit):
+            calls.append("search")
+
+        def metadata(self, candidate, at):
+            calls.append("metadata")
+
+    class UnusedFiles:
+        def read(self, candidate):
+            calls.append("files")
+
+    class UnusedModel:
+        def evaluate(self, digest):
+            calls.append("evaluate")
+
+        def flags_malicious(self, digest):
+            calls.append("flags")
+
+    class UnusedClock:
+        def now(self):
+            calls.append("clock")
+
+    with pytest.raises(
+        ValueError,
+        match="category pack 'coding-agents' names unavailable evidence: source",
+    ):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(
+                UnusedRepository(),
+                UnusedFiles(),
+                UnusedModel(),
+                UnusedClock(),
+                UnsupportedEvidence(),
+            ),
+        )
+
+    assert calls == []
