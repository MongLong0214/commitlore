+def test_observations_sort_by_recorded_time_then_recording_sequence(tmp_path) -> None:
+    # Given: runs are saved out of timestamp order, including two at the same time.
+    older = AT - timedelta(days=1)
+    later = AT + timedelta(days=1)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("newest", artifact(stars=20, at=later))
+        store.save("first-at", artifact(stars=10, at=AT))
+        store.save("backfilled", artifact(stars=4, at=older))
+        store.save("second-at", artifact(stars=12, at=AT))
+
+        # When: observation history is read after the backfill.
+        observations = store.observations()
+
+    # Then: time determines the order, while equal times keep insertion sequence.
+    assert tuple((item.run_id, item.observed_at, item.stars) for item in observations) == (
+        ("backfilled", older, 4),
+        ("first-at", AT, 10),
+        ("second-at", AT, 12),
+        ("newest", later, 20),
+    )
+
+
