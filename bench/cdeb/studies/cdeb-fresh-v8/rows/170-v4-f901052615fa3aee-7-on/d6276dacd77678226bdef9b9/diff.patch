+        store.save("third", artifact(stars=9, at=latest))
+
+        # When: callers request only the two most recently appended observations.
+        full_observations = store.observations()
+        recent_observations = store.observations(limit=2)
+
+    # Then: the slice retains each derived observation's stored values and order.
+    assert [record.run_id for record in full_observations] == ["first", "second", "third"]
+    assert [
+        (record.run_id, record.repo, record.observed_at, record.stars)
+        for record in recent_observations
+    ] == [
+        ("second", "org/repo", later, 7),
