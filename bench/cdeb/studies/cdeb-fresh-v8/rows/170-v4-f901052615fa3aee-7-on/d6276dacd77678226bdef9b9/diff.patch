+def test_history_limit_returns_the_recent_slice_in_append_order(tmp_path) -> None:
+    # Given: three real persisted artifacts in their append order.
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", artifact(stars=4))
+        store.save("second", artifact(stars=7))
+        store.save("third", artifact(stars=9), corrects_run_id="first")
+
+        # When: callers request only the two most recent stored runs.
+        full_history = store.history()
+        recent_history = store.history(limit=2)
+
+    # Then: the slice preserves its stored artifact values and append order.
+    assert [record.run_id for record in full_history] == ["first", "second", "third"]
+    assert [(record.run_id, record.corrects_run_id) for record in recent_history] == [
+        ("second", None),
+        ("third", "first"),
+    ]
+    assert [record.artifact.collection.candidates[0].stars for record in recent_history] == [7, 9]
+
