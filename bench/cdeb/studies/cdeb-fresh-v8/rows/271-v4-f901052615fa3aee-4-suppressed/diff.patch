+def test_history_limit_returns_the_recent_records_in_append_order(tmp_path) -> None:
+    # Given: three persisted runs in append order.
+    path = tmp_path / "runs.db"
+    artifacts = tuple(artifact(stars=stars) for stars in (4, 7, 9))
+    with SQLiteRunStore(path) as store:
+        for index, recorded in enumerate(artifacts, start=1):
+            store.save(
+                f"run-{index}",
+                recorded,
+                corrects_run_id="run-2" if index == 3 else None,
+            )
+
+    # When: a bounded history is read from the persisted store.
+    with SQLiteRunStore(path) as store:
+        recent = store.history(limit=2)
+        complete = store.history()
+
+    # Then: it retains the last two complete stored records in their append order.
+    assert tuple(
+        (record.run_id, record.corrects_run_id, record.artifact.to_bytes()) for record in recent
+    ) == (
+        ("run-2", None, artifacts[1].to_bytes()),
+        ("run-3", "run-2", artifacts[2].to_bytes()),
+    )
+    assert tuple(record.run_id for record in complete) == ("run-1", "run-2", "run-3")
+
+
+def test_observations_limit_returns_the_recent_records_in_append_order(tmp_path) -> None:
+    # Given: three persisted runs that each derive one repository observation.
+    path = tmp_path / "runs.db"
+    observed_at = tuple(
+        datetime(2026, 7, day, 12, 0, tzinfo=timezone.utc) for day in (27, 28, 29)
+    )
+    with SQLiteRunStore(path) as store:
+        for index, (at, stars) in enumerate(zip(observed_at, (4, 7, 9)), start=1):
+            store.save(f"run-{index}", artifact(stars=stars, at=at))
+
+    # When: a bounded observation history is read from the persisted store.
+    with SQLiteRunStore(path) as store:
+        recent = store.observations(limit=2)
+        complete = store.observations()
+
+    # Then: it retains the last two derived records and their existing values.
+    assert recent == (
+        StoredObservation("run-2", CANDIDATE.repo, observed_at[1], 7),
+        StoredObservation("run-3", CANDIDATE.repo, observed_at[2], 9),
+    )
+    assert tuple(observation.run_id for observation in complete) == ("run-1", "run-2", "run-3")
+
+
+@pytest.mark.parametrize("method", ("history", "observations"))
+@pytest.mark.parametrize("limit", (0, -1, True, 1.5))
+def test_bounded_store_reads_require_a_positive_integer_limit(tmp_path, method, limit) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(ValueError, match="limit must be positive"):
+            getattr(store, method)(limit=limit)
+
