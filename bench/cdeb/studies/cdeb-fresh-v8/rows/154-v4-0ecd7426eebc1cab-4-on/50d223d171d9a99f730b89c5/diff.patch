+def test_unreadable_files_use_the_configured_category_evidence_vocabulary() -> None:
+    class CustomEvidence:
+        evidence_names = frozenset({"files", "source", "custom"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("files were unavailable, so evidence must not be read")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(Repository(), Files(OSError("offline")), Model(), Clock(), CustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+
+    trace = artifact.repositories[0]
+    assert trace.category_evidence == (
+        Evidence("custom", frozenset(), ClaimBasis.ABSENT),
+        Evidence("files", frozenset(), ClaimBasis.ABSENT),
+        Evidence("source", frozenset(), ClaimBasis.ABSENT),
+    )
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
+
+
+def test_unsupported_category_reader_fails_before_operational_ports_are_invoked() -> None:
+    class UnsupportedEvidence:
+        evidence_names = frozenset({"files"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("evidence cannot be read")
+
+    class UnusedRepository:
+        def search(self, query, limit):
+            raise AssertionError("repository search must not run")
+
+        def metadata(self, candidate, at):
+            raise AssertionError("repository metadata must not run")
+
+    class UnusedFiles:
+        def read(self, candidate):
+            raise AssertionError("file read must not run")
+
+    class UnusedModel:
+        def evaluate(self, digest):
+            raise AssertionError("model evaluation must not run")
+
+        def flags_malicious(self, digest):
+            raise AssertionError("model screening must not run")
+
+    class UnusedClock:
+        def now(self):
+            raise AssertionError("clock must not run")
+
+    with pytest.raises(ValueError, match="category pack 'coding-agents' names unavailable evidence: source"):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(UnusedRepository(), UnusedFiles(), UnusedModel(), UnusedClock(), UnsupportedEvidence()),
+        )
