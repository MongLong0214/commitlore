+def test_history_limit_returns_recent_persisted_artifacts_in_append_order(tmp_path) -> None:
+    # Given: three persisted run artifacts, including a correction link.
+    recorded = (
+        artifact(stars=4),
+        artifact(stars=7),
+        artifact(stars=9),
+    )
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", recorded[0])
+        store.save("second", recorded[1], corrects_run_id="first")
+        store.save("third", recorded[2])
+
+        # When: callers ask for the two most recently appended runs.
+        recent = store.history(limit=2)
+
+        # Then: the complete history is unchanged and the slice preserves append order and values.
+        assert [run.run_id for run in store.history()] == ["first", "second", "third"]
+        assert [(run.run_id, run.corrects_run_id, run.artifact.to_bytes()) for run in recent] == [
+            ("second", "first", recorded[1].to_bytes()),
+            ("third", None, recorded[2].to_bytes()),
+        ]
+
+
+def test_observations_limit_returns_recent_derived_observations_in_append_order(tmp_path) -> None:
+    # Given: three runs that derive repository observations at distinct times and star counts.
+    observed_at = (
+        AT,
+        datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc),
+        datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc),
+    )
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for run_id, stars, at in zip(("first", "second", "third"), (4, 7, 9), observed_at):
+            store.save(run_id, artifact(stars=stars, at=at))
+
+        # When: callers ask for the two most recently appended observations.
+        recent = store.observations(limit=2)
+
+        # Then: the complete history is unchanged and returned values retain append order.
+        assert [observation.run_id for observation in store.observations()] == [
+            "first",
+            "second",
+            "third",
+        ]
+        assert recent == (
+            StoredObservation("second", "org/repo", observed_at[1], 7),
+            StoredObservation("third", "org/repo", observed_at[2], 9),
+        )
+
+
