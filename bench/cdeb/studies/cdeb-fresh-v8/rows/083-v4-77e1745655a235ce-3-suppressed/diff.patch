+def _normalize_entry(name: str) -> str:
+    """Normalize dependency/configuration names without collapsing their words."""
+    return _ENTRY_SEPARATOR.sub("-", name.strip().casefold())
+
+
+def _package_json_entries(text: str) -> frozenset[str]:
+    """Read JSON object keys plus names in the dependency-only array form."""
+    try:
+        manifest = json.loads(text)
+    except (TypeError, json.JSONDecodeError):
+        return frozenset()
+    if not isinstance(manifest, dict):
+        return frozenset()
+
+    entries: set[str] = set()
+
+    def visit(value: object) -> None:
+        if isinstance(value, dict):
+            entries.update(_normalize_entry(key) for key in value)
+            for nested in value.values():
+                visit(nested)
+        elif isinstance(value, list):
+            for nested in value:
+                visit(nested)
+
+    visit(manifest)
+    for field in ("bundledDependencies", "bundleDependencies"):
+        dependencies = manifest.get(field)
+        if isinstance(dependencies, list):
+            entries.update(_normalize_entry(item) for item in dependencies if isinstance(item, str))
+    return frozenset(entries)
+
+
+def _toml_entries(text: str) -> frozenset[str]:
+    """Extract TOML keys/tables and names in a ``dependencies = [...]`` list."""
+    uncommented = "\n".join(_strip_toml_comment(line) for line in text.splitlines())
+    entries: set[str] = set()
+    table_entries: tuple[str, ...] = ()
+    dependency_array: list[str] | None = None
+    for line in uncommented.splitlines():
+        table = _TOML_TABLE.match(line)
+        if table:
+            table_entries = tuple(_normalize_entry(part.strip().strip("\"'")) for part in table.group(1).split("."))
+            entries.update(table_entries)
+            continue
+        assignment = _TOML_ASSIGNMENT.match(line)
+        if assignment:
+            key = _normalize_entry(next(value for value in assignment.groups()[:3] if value is not None))
+            entries.add(key)
+            if key == "dependencies" or (table_entries and table_entries[-1] in _DEPENDENCY_LIST_TABLES):
+                dependency_array = [assignment.group(4)]
+            else:
+                dependency_array = None
+        elif dependency_array is not None:
+            dependency_array.append(line)
+        if dependency_array is not None and dependency_array.count("[") <= dependency_array.count("]"):
+            _add_toml_dependency_names(entries, "\n".join(dependency_array))
+            dependency_array = None
+    return frozenset(entries)
+
+
+def _add_toml_dependency_names(entries: set[str], value: str) -> None:
+    for quoted in _TOML_QUOTED_VALUE.findall(value):
+        requirement = next(item for item in quoted if item)
+        entry = _REQUIREMENT_ENTRY.match(requirement)
+        if entry:
+            entries.add(_normalize_entry(entry.group(1)))
+
+
+def _strip_toml_comment(line: str) -> str:
+    quote: str | None = None
+    escaped = False
+    for index, character in enumerate(line):
+        if quote:
+            if character == quote and not escaped:
+                quote = None
+            escaped = character == "\\" and not escaped
+        elif character in {"\"", "'"}:
+            quote = character
+        elif character == "#":
+            return line[:index]
+    return line
+
+
+def _go_mod_dependencies(text: str) -> frozenset[str]:
+    """Read module names declared by dependency and replacement directives."""
+    entries: set[str] = set()
+    in_entry_block = False
+    for raw_line in text.splitlines():
+        line = raw_line.split("//", 1)[0].strip()
+        if not line:
+            continue
+        if in_entry_block:
+            if line == ")":
+                in_entry_block = False
+            else:
+                entry = _REQUIREMENT_ENTRY.match(line)
+                if entry:
+                    entries.add(_normalize_entry(entry.group(1)))
+            continue
+        directive = re.match(r"(?:require|replace|exclude)\s+(.*)", line)
+        if not directive:
+            continue
+        if directive.group(1).strip() == "(":
+            in_entry_block = True
+            continue
+        entry = _REQUIREMENT_ENTRY.match(directive.group(1))
+        if entry:
+            entries.add(_normalize_entry(entry.group(1)))
+    return frozenset(entries)
+
+
+def _requirement_entries(text: str) -> frozenset[str]:
+    entries: set[str] = set()
+    for raw_line in text.splitlines():
+        line = raw_line.strip()
+        if not line or line.startswith("#"):
+            continue
+        egg = _REQUIREMENT_EGG.search(line)
+        if egg:
+            entries.add(_normalize_entry(egg.group(1)))
+            continue
+        if line.startswith(("-", "--")):
+            continue
+        entry = _REQUIREMENT_ENTRY.match(line)
+        if entry:
+            entries.add(_normalize_entry(entry.group(1)))
+    return frozenset(entries)
+
+
 DEFAULT_EVIDENCE_READER: Final = FileEvidenceReader()
 
 
