+_ENTRY_SEPARATOR: Final = re.compile(r"[-_.]+")
+_TOML_TABLE: Final = re.compile(r"^\s*\[\[?\s*(.*?)\s*\]\]?\s*$")
+_TOML_ASSIGNMENT: Final = re.compile(r"^\s*(?:\"([^\"]+)\"|'([^']+)'|([A-Za-z0-9_.-]+))\s*=(.*)$")
+_TOML_QUOTED_VALUE: Final = re.compile(r"(?:\"([^\"]+)\"|'([^']+)')")
+_REQUIREMENT_ENTRY: Final = re.compile(r"^\s*([A-Za-z0-9][A-Za-z0-9_.-]*)")
+_REQUIREMENT_EGG: Final = re.compile(r"#egg=([A-Za-z0-9][A-Za-z0-9_.-]*)", re.IGNORECASE)
+_DEPENDENCY_LIST_TABLES: Final = frozenset({"optional-dependencies", "dependency-groups", "dev-dependencies"})
