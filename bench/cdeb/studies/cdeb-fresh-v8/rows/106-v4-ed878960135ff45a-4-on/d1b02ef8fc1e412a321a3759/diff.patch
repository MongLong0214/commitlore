+def test_observations_sort_backfilled_runs_by_recorded_time(tmp_path) -> None:
+    # Given: a newer observation is saved before an older backfill and a same-time run.
+    later = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("newer-first", artifact(stars=9, at=later))
+        store.save("older", artifact(stars=4, at=AT))
+        store.save("newer-second", artifact(stars=10, at=later))
+
+        # When: the observation history is read.
+        observations = store.observations()
+
+    # Then: time orders history, while equal times retain recording order.
+    assert [(item.run_id, item.observed_at, item.stars) for item in observations] == [
+        ("older", AT, 4),
+        ("newer-first", later, 9),
+        ("newer-second", later, 10),
+    ]
+
+
