+def test_observations_order_by_recorded_time_then_recording_sequence(tmp_path) -> None:
+    # Given: a newer observation is saved before two observations recorded at the same older time.
+    older = datetime(2026, 7, 26, 12, 0, tzinfo=timezone.utc)
+    newer = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("newer", artifact(stars=9, at=newer))
+        store.save("older-first", artifact(stars=4, at=older))
+        store.save("older-second", artifact(stars=5, at=older))
+
+        # When: history is read after the out-of-order saves.
+        observations = store.observations()
+
+    # Then: recorded time is chronological and equal times retain save sequence.
+    observed_values = [
+        (observation.run_id, observation.observed_at, observation.stars)
+        for observation in observations
+    ]
+    assert observed_values == [
+        ("older-first", older, 4),
+        ("older-second", older, 5),
+        ("newer", newer, 9),
+    ]
+
+
