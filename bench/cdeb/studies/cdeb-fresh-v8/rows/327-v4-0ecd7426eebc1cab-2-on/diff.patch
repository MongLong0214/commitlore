+def test_unsupported_category_evidence_stops_before_any_port_is_invoked() -> None:
+    calls = []
+
+    class IncompatibleEvidence:
+        evidence_names = frozenset({"files"})
+
+        def read_evidence(self, candidate, files, metadata):
+            calls.append("evidence")
+
+    class GuardedRepository:
+        def search(self, query, limit):
+            calls.append("search")
+
+        def metadata(self, candidate, at):
+            calls.append("metadata")
+
+    class GuardedFiles:
+        def read(self, candidate):
+            calls.append("files")
+
+    class GuardedModel:
+        def evaluate(self, digest):
+            calls.append("evaluate")
+
+        def flags_malicious(self, digest):
+            calls.append("malicious")
+
+    class GuardedClock:
+        def now(self):
+            calls.append("clock")
+
+    with pytest.raises(ValueError, match="category pack 'coding-agents' names unavailable evidence: source"):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(
+                GuardedRepository(),
+                GuardedFiles(),
+                GuardedModel(),
+                GuardedClock(),
+                IncompatibleEvidence(),
+            ),
+        )
+
+    assert calls == []
+
+
+def test_custom_evidence_vocabulary_records_absence_when_files_are_unreadable(monkeypatch) -> None:
+    pack = CategoryPack("custom", "v1", (EvidenceRequirement("custom", "marker"),))
+    monkeypatch.setattr("gitseed.category.CATEGORY_PACKS", (pack,))
+
+    class CustomEvidence:
+        evidence_names = frozenset({"custom"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("evidence must not be read without repository files")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("custom",)),
+        RunPorts(
+            Repository(), Files(OSError("offline")), Model(), Clock(), CustomEvidence()
+        ),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+    trace = artifact.repositories[0]
+
+    assert trace.category_evidence == (Evidence("custom", frozenset(), ClaimBasis.ABSENT),)
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
+    assert trace.categories[0].missing_evidence == ("custom",)
+
+
+def test_custom_evidence_vocabulary_records_absence_when_reader_fails(monkeypatch) -> None:
+    pack = CategoryPack("custom", "v1", (EvidenceRequirement("custom", "marker"),))
+    monkeypatch.setattr("gitseed.category.CATEGORY_PACKS", (pack,))
+
+    class BrokenCustomEvidence:
+        evidence_names = frozenset({"custom"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise RuntimeError("custom evidence unavailable")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("custom",)),
+        RunPorts(
+            Repository(), Files(), Model(), Clock(), BrokenCustomEvidence()
+        ),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+    trace = artifact.repositories[0]
+
+    assert trace.category_evidence == (Evidence("custom", frozenset(), ClaimBasis.ABSENT),)
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
+    assert trace.categories[0].missing_evidence == ("custom",)
