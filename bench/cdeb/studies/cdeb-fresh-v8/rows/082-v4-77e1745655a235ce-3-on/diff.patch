+    def _manifest_entry_names(self, files: FetchedFiles) -> frozenset[str]:
+        names = set()
+        for path, text in files.files:
+            filename = path.rsplit("/", 1)[-1]
+            if filename not in _MANIFEST_FILENAMES:
+                continue
+            if filename == "package.json":
+                names.update(_package_entries(text))
+            elif filename == "pyproject.toml":
+                names.update(_pyproject_entries(text))
+            elif filename == "Cargo.toml":
+                names.update(_cargo_entries(text))
+            elif filename == "go.mod":
+                names.update(_go_entries(text))
+            elif filename == "requirements.txt":
+                names.update(_requirements_entries(text))
+        return frozenset(_normalize_entry(name) for name in names)
 
     def _producer_name(self, producer) -> str:
         return producer.__name__.removeprefix("_")
 
 
+def _normalize_entry(name: str) -> str:
+    return name.strip().casefold()
+
+
+def _package_entries(text: str) -> set[str]:
+    try:
+        manifest = json.loads(text)
+    except json.JSONDecodeError:
+        return set()
+    if not isinstance(manifest, dict):
+        return set()
+
+    entries = _mapping_entry_names(manifest.get("config"))
+    for section in _PACKAGE_ENTRY_SECTIONS:
+        entries.update(_mapping_entry_names(manifest.get(section)))
+    pnpm = manifest.get("pnpm")
+    if isinstance(pnpm, dict):
+        entries.update(_mapping_entry_names(pnpm.get("overrides")))
+    return entries
+
+
+def _mapping_entry_names(value: object) -> set[str]:
+    if isinstance(value, dict):
+        return {key for key in value if isinstance(key, str)}
+    if isinstance(value, list):
+        return {entry for entry in value if isinstance(entry, str)}
+    return set()
+
+
+def _pyproject_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    section: tuple[str, ...] = ()
+    for line in _toml_lines(text):
+        heading = _toml_heading(line)
+        if heading is not None:
+            section = heading
+            if len(section) > 1 and section[0] == "tool":
+                entries.add(section[1])
+            continue
+        key, value = _toml_assignment(line)
+        if key is None:
+            continue
+        if section == ("project",) and key == "dependencies":
+            entries.update(_toml_dependency_values(value))
+        elif section == ("project", "optional-dependencies"):
+            entries.update(_toml_dependency_values(value))
+    return entries
+
+
+def _cargo_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    section: tuple[str, ...] = ()
+    for line in _toml_lines(text):
+        heading = _toml_heading(line)
+        if heading is not None:
+            section = heading
+            if len(section) > 2 and section[:2] == ("package", "metadata"):
+                entries.add(section[2])
+            continue
+        key, _ = _toml_assignment(line)
+        if key is not None and section and section[-1] in {"dependencies", "dev-dependencies", "build-dependencies"}:
+            entries.add(key)
+    return entries
+
+
+def _toml_lines(text: str) -> tuple[str, ...]:
+    lines: list[str] = []
+    pending = ""
+    for raw_line in text.splitlines():
+        quote = ""
+        escaped = False
+        line = raw_line
+        for index, character in enumerate(raw_line):
+            if character in {"'", '"'} and not escaped:
+                quote = "" if quote == character else character if not quote else quote
+            if character == "#" and not quote:
+                line = raw_line[:index]
+                break
+            escaped = character == "\\" and not escaped
+        line = line.strip()
+        if not line:
+            continue
+        pending = f"{pending} {line}".strip()
+        if pending.count("[") > pending.count("]"):
+            continue
+        lines.append(pending)
+        pending = ""
+    if pending:
+        lines.append(pending)
+    return tuple(lines)
+
+
+def _toml_heading(line: str) -> tuple[str, ...] | None:
+    matched = re.fullmatch(r"\[\s*([^]]+?)\s*\]", line)
+    if not matched:
+        return None
+    return tuple(part.strip().casefold() for part in matched.group(1).split("."))
+
+
+def _toml_assignment(line: str) -> tuple[str | None, str]:
+    matched = re.match(r'\s*([A-Za-z0-9_-]+|"[^"]+"|\'[^\']+\')\s*=\s*(.*)', line)
+    if not matched:
+        return None, ""
+    return matched.group(1).strip("\"'").casefold(), matched.group(2)
+
+
+def _toml_dependency_values(value: str) -> set[str]:
+    return {
+        matched.group(1)
+        for quoted in re.findall(r'"([^"\\]*(?:\\.[^"\\]*)*)"|\'([^\'\\]*(?:\\.[^\'\\]*)*)\'', value)
+        for matched in [_DEPENDENCY_NAME.match(quoted[0] or quoted[1])]
+        if matched
+    }
+
+
+def _go_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    in_require_block = False
+    for raw_line in text.splitlines():
+        line = raw_line.split("//", 1)[0].strip()
+        if line == "require (":
+            in_require_block = True
+            continue
+        if in_require_block and line == ")":
+            in_require_block = False
+            continue
+        if line.startswith("require "):
+            _add_go_requirement(entries, line.removeprefix("require "))
+        elif in_require_block and line:
+            _add_go_requirement(entries, line)
+    return entries
+
+
+def _add_go_requirement(entries: set[str], line: str) -> None:
+    name, *rest = line.split(maxsplit=1)
+    if rest and rest[0].startswith("v"):
+        entries.add(name)
+
+
+def _requirements_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    for raw_line in text.splitlines():
+        line = raw_line.split("#", 1)[0].strip()
+        if not line or line.startswith(("-", ".", "/")):
+            continue
+        matched = _DEPENDENCY_NAME.match(line)
+        if matched:
+            entries.add(matched.group(1))
+    return entries
+
+
 DEFAULT_EVIDENCE_READER: Final = FileEvidenceReader()
 
 
