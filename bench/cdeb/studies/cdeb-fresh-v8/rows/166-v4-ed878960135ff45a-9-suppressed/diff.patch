+def test_observations_order_backfilled_runs_by_recorded_time(tmp_path) -> None:
+    # Given: a newer run is saved before a backfilled older observation.
+    older = datetime(2026, 7, 26, 12, 0, tzinfo=timezone.utc)
+    newer = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("newer", artifact(stars=30, at=newer))
+        store.save("first-at", artifact(stars=10, at=AT))
+        store.save("second-at", artifact(stars=20, at=AT))
+
+        # When: an older run is saved after all of them.
+        store.save("backfilled", artifact(stars=5, at=older))
+        observations = store.observations()
+
+    # Then: observation time determines the order, with insertion order at ties.
+    actual = [
+        (observation.run_id, observation.observed_at, observation.stars)
+        for observation in observations
+    ]
+    expected = [
+        ("backfilled", older, 5),
+        ("first-at", AT, 10),
+        ("second-at", AT, 20),
+        ("newer", newer, 30),
+    ]
+    assert actual == expected
+
+
