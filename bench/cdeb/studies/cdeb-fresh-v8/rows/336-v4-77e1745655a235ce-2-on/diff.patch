@@ -75,12 +76,154 @@ class FileEvidenceReader:
             basis,
         )
 
-    def _manifest(self, files: FetchedFiles) -> str:
-        return "\n".join(
-            text.lower()
-            for path, text in files.files
-            if path.rsplit("/", 1)[-1] in {"package.json", "pyproject.toml", "Cargo.toml", "go.mod", "requirements.txt"}
-        )
+    def _manifest_entry_names(self, files: FetchedFiles) -> frozenset[str]:
+        entries: set[str] = set()
+        for path, text in files.files:
+            name = path.rsplit("/", 1)[-1]
+            if name == "package.json":
+                entries.update(self._package_entries(text))
+            elif name == "pyproject.toml":
+                entries.update(self._pyproject_entries(text))
+            elif name == "Cargo.toml":
+                entries.update(self._cargo_entries(text))
+            elif name == "go.mod":
+                entries.update(self._go_entries(text))
+            elif name == "requirements.txt":
+                entries.update(self._requirements_entries(text))
+        return frozenset(entries)
+
+    @staticmethod
+    def _package_entries(text: str) -> set[str]:
+        """Return declared package dependencies and npm config entry names."""
+        try:
+            manifest = json.loads(text)
+        except (TypeError, ValueError):
+            return set()
+        if not isinstance(manifest, dict):
+            return set()
+
+        entries: set[str] = set()
+        for field in (
+            "dependencies",
+            "devDependencies",
+            "optionalDependencies",
+            "peerDependencies",
+            "bundledDependencies",
+            "bundleDependencies",
+        ):
+            value = manifest.get(field)
+            if isinstance(value, dict):
+                entries.update(value)
+            elif field in {"bundledDependencies", "bundleDependencies"} and isinstance(value, list):
+                entries.update(item for item in value if isinstance(item, str))
+        config = manifest.get("config")
+        if isinstance(config, dict):
+            entries.update(config)
+        return {FileEvidenceReader._normalize_entry(entry) for entry in entries}
+
+    @staticmethod
+    def _pyproject_entries(text: str) -> set[str]:
+        entries: set[str] = set()
+        section = ""
+        array: str | None = None
+        for line in text.splitlines():
+            line = FileEvidenceReader._without_toml_comment(line).strip()
+            if array is not None:
+                array += " " + line
+                if "]" in line:
+                    entries.update(FileEvidenceReader._toml_array_entries(array))
+                    array = None
+                continue
+            table = re.fullmatch(r"\[([^]]+)\]", line)
+            if table:
+                section = table.group(1).lower()
+                if section.startswith("tool."):
+                    entries.add(section.split(".", 2)[1])
+                continue
+            is_dependency_array = (
+                section == "project" and re.match(r"dependencies\s*=", line)
+            ) or (section == "project.optional-dependencies" and "=" in line)
+            if is_dependency_array:
+                value = line.split("=", 1)[1]
+                if "]" in value:
+                    entries.update(FileEvidenceReader._toml_array_entries(value))
+                else:
+                    array = value
+            elif section.startswith("tool.") and "=" in line:
+                entries.add(line.split("=", 1)[0].strip())
+        return {FileEvidenceReader._normalize_entry(entry) for entry in entries}
+
+    @staticmethod
+    def _cargo_entries(text: str) -> set[str]:
+        entries: set[str] = set()
+        section = ""
+        for line in text.splitlines():
+            line = FileEvidenceReader._without_toml_comment(line).strip()
+            table = re.fullmatch(r"\[([^]]+)\]", line)
+            if table:
+                section = table.group(1).lower()
+                if section.startswith("package.metadata."):
+                    entries.add(section.removeprefix("package.metadata.").split(".", 1)[0])
+                continue
+            if FileEvidenceReader._cargo_dependency_section(section) and "=" in line:
+                entries.add(line.split("=", 1)[0].strip())
+        return {FileEvidenceReader._normalize_entry(entry) for entry in entries}
+
+    @staticmethod
+    def _go_entries(text: str) -> set[str]:
+        entries: set[str] = set()
+        in_require_block = False
+        for line in text.splitlines():
+            line = line.split("//", 1)[0].strip()
+            if line == "require (":
+                in_require_block = True
+                continue
+            if in_require_block and line == ")":
+                in_require_block = False
+                continue
+            if line.startswith("require "):
+                line = line.removeprefix("require ").strip()
+            elif not in_require_block:
+                continue
+            if line:
+                entries.add(line.split()[0])
+        return {FileEvidenceReader._normalize_entry(entry) for entry in entries}
+
+    @staticmethod
+    def _requirements_entries(text: str) -> set[str]:
+        entries: set[str] = set()
+        for line in text.splitlines():
+            line = line.split("#", 1)[0].strip()
+            if not line or line.startswith(("-", ".", "/")):
+                continue
+            match = re.match(r"[A-Za-z0-9_.-]+", line)
+            if match:
+                entries.add(match.group())
+        return {FileEvidenceReader._normalize_entry(entry) for entry in entries}
+
+    @staticmethod
+    def _without_toml_comment(line: str) -> str:
+        return line.split("#", 1)[0]
+
+    @staticmethod
+    def _toml_array_entries(line: str) -> set[str]:
+        return {
+            FileEvidenceReader._requirement_entry_name(entry)
+            for entry in re.findall(r'["\']([^"\']+)["\']', line)
+        }
+
+    @staticmethod
+    def _requirement_entry_name(entry: str) -> str:
+        match = re.match(r"[A-Za-z0-9_.-]+", entry.strip())
+        return match.group() if match else entry
+
+    @staticmethod
+    def _cargo_dependency_section(section: str) -> bool:
+        return section.endswith("dependencies") or ".dependencies" in section
+
+    @staticmethod
+    def _normalize_entry(entry: str) -> str:
+        return re.sub(r"[-_.]+", "-", entry.strip().lower())
 
     def _producer_name(self, producer) -> str:
         return producer.__name__.removeprefix("_")
