@@ -172,3 +172,55 @@ def test_same_version_packs_keep_distinct_identities() -> None:
 
     assert mcp.pack != local_ai.pack
     assert (mcp.pack.name, mcp.pack.version) == ("mcp", "v1")
+
+
+@pytest.mark.parametrize(
+    ("path", "contents"),
+    (
+        ("package.json", '{"dependencies": {"MCP": "1"}, "config": {"Ollama": true}}'),
+        ("pyproject.toml", '[project]\ndependencies = ["MCP>=1", "Ollama[server]"]'),
+        ("Cargo.toml", '[dependencies]\nMCP = "1"\nollama = "1"'),
+        ("go.mod", 'module example.test/app\n\nrequire (\n    MCP v1.0.0\n    ollama v1.0.0\n)'),
+        ("requirements.txt", "MCP>=1\nOllama[server]==1"),
+    ),
+)
+def test_manifest_entry_names_produce_category_evidence(path: str, contents: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, contents),)),
+        None,
+    )
+
+    assert {item.evidence: item.values for item in evidence} == {
+        "files": frozenset(),
+        "manifest_entries": frozenset({"mcp"}),
+        "dependencies": frozenset({"ollama"}),
+        "source": frozenset(),
+    }
+    assert {item.basis for item in evidence} == {ClaimBasis.DETERMINISTIC}
+
+
