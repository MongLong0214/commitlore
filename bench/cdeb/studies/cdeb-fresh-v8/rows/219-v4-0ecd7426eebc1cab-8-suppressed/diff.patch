diff --git a/tests/test_seam.py b/tests/test_seam.py
index cc155de..ff7374c 100644
--- a/tests/test_seam.py
+++ b/tests/test_seam.py
@@ -381,3 +381,74 @@ def test_broken_category_reader_does_not_change_the_approval_inputs() -> None:
     assert artifact.scores[0].recommendation.status.value == "review"
     assert artifact.repositories[0].categories[0].basis is ClaimBasis.ABSENT
     assert any(failure.port == "category" for failure in artifact.failures)
+
+
+def test_incompatible_evidence_reader_fails_before_operational_ports_run() -> None:
+    calls = []
+
+    class NoOperation:
+        def __getattr__(self, name):
+            calls.append(name)
+            raise AssertionError(f"operational port method {name} was called")
+
+    class FilesOnlyEvidence:
+        evidence_names = frozenset({"files"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("evidence should have been rejected before reading")
+
+    with pytest.raises(ValueError, match="category pack 'coding-agents' names unavailable evidence: source"):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(NoOperation(), NoOperation(), NoOperation(), NoOperation(), FilesOnlyEvidence()),
+        )
+
+    assert calls == []
+
+
+def test_category_reader_failure_records_its_custom_vocabulary_as_absent() -> None:
+    class BrokenCustomEvidence:
+        evidence_names = frozenset({"manifest_entries", "custom"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise RuntimeError("category reader deliberately unavailable")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("mcp",)),
+        RunPorts(Repository(), Files(), Model(), Clock(), BrokenCustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+    trace = artifact.repositories[0]
+
+    assert {(item.evidence, item.values, item.basis) for item in trace.category_evidence} == {
+        ("manifest_entries", frozenset(), ClaimBasis.ABSENT),
+        ("custom", frozenset(), ClaimBasis.ABSENT),
+    }
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
+
+
+def test_unreadable_files_record_the_configured_evidence_vocabulary_as_absent() -> None:
+    class CustomEvidence:
+        evidence_names = frozenset({"manifest_entries", "custom"})
+
+        def __init__(self) -> None:
+            self.reads = 0
+
+        def read_evidence(self, candidate, files, metadata):
+            self.reads += 1
+            raise AssertionError("evidence reader should not run without files")
+
+    evidence = CustomEvidence()
+    artifact = execute(
+        RunRequest("small tools", 1, ("mcp",)),
+        RunPorts(Repository(), Files(OSError("offline")), Model(), Clock(), evidence),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+    trace = artifact.repositories[0]
+
+    assert {(item.evidence, item.values, item.basis) for item in trace.category_evidence} == {
+        ("manifest_entries", frozenset(), ClaimBasis.ABSENT),
+        ("custom", frozenset(), ClaimBasis.ABSENT),
+    }
+    assert evidence.reads == 0
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
