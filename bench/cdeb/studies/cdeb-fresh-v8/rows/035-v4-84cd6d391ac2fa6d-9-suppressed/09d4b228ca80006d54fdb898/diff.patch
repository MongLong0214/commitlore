+def test_get_returns_a_correction_with_its_lineage(tmp_path) -> None:
+    # Given: an immutable correction follows an original stored run.
+    correction = artifact()
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("run-1", artifact())
+        store.save("run-2", correction, corrects_run_id="run-1")
+
+        # When: the correction is looked up directly.
+        stored = store.get("run-2")
+
+    # Then: its artifact and correction source are both available without history.
+    assert stored.run_id == "run-2"
+    assert stored.corrects_run_id == "run-1"
+    assert stored.artifact.to_bytes() == correction.to_bytes()
+
+
+def test_get_raises_key_error_for_an_unknown_run(tmp_path) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(KeyError) as error:
+            store.get("missing-run")
+
+    assert error.value.args == ("missing-run",)
+
