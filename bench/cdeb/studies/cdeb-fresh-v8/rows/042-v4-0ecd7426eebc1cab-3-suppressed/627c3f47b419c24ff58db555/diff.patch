diff --git a/tests/test_seam.py b/tests/test_seam.py
index cc155de..5b741e8 100644
--- a/tests/test_seam.py
+++ b/tests/test_seam.py
@@ -381,3 +381,70 @@ def test_broken_category_reader_does_not_change_the_approval_inputs() -> None:
     assert artifact.scores[0].recommendation.status.value == "review"
     assert artifact.repositories[0].categories[0].basis is ClaimBasis.ABSENT
     assert any(failure.port == "category" for failure in artifact.failures)
+
+
+def test_category_reader_capability_is_checked_before_operational_ports() -> None:
+    calls = []
+
+    class UnsupportedEvidence:
+        evidence_names = frozenset({"files", "manifest_entries", "dependencies"})
+
+        def read_evidence(self, candidate, files, metadata):
+            calls.append("evidence")
+            raise AssertionError("unsupported reader must not be called")
+
+    class UnusedRepository(Repository):
+        def search(self, query: str, limit: int) -> CollectResult:
+            calls.append("search")
+            return super().search(query, limit)
+
+    class UnusedClock(Clock):
+        def now(self) -> datetime:
+            calls.append("clock")
+            return super().now()
+
+    with pytest.raises(
+        ValueError,
+        match="category pack 'coding-agents' names unavailable evidence: source",
+    ):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(UnusedRepository(), Files(), Model(), UnusedClock(), UnsupportedEvidence()),
+            model_smoke=SmokeResult(True, "fixture"),
+        )
+
+    assert calls == []
+
+
+@pytest.mark.parametrize("files_fail", (True, False))
+def test_category_evidence_absence_uses_the_injected_reader_vocabulary(files_fail: bool) -> None:
+    reads = []
+
+    class CustomEvidence:
+        evidence_names = frozenset({"files", "manifest_entries", "dependencies", "source", "custom"})
+
+        def read_evidence(self, candidate, files, metadata):
+            reads.append(candidate.repo)
+            if files_fail:
+                raise AssertionError("evidence reader must not be called without files")
+            raise OSError("custom evidence unavailable")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(
+            Repository(),
+            Files(OSError("source unavailable")) if files_fail else Files(),
+            Model(),
+            Clock(),
+            CustomEvidence(),
+        ),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+    trace = artifact.repositories[0]
+
+    assert {(item.evidence, item.values, item.basis) for item in trace.category_evidence} == {
+        (name, frozenset(), ClaimBasis.ABSENT)
+        for name in CustomEvidence.evidence_names
+    }
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
+    assert reads == ([] if files_fail else [CANDIDATE.repo])
