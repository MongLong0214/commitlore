+def test_point_lookup_returns_a_correction_with_its_lineage(tmp_path) -> None:
+    # Given: a correction points to an earlier immutable run.
+    original = artifact(Files(OSError("offline")))
+    correction = artifact()
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("original", original)
+        store.save("correction", correction, corrects_run_id="original")
+
+        # When: a consumer retrieves the correction by its known identifier.
+        stored = store.get("correction")
+
+    # Then: the correction artifact and its lineage are both available.
+    assert stored.run_id == "correction"
+    assert stored.corrects_run_id == "original"
+    assert stored.artifact.to_bytes() == correction.to_bytes()
+
+
+def test_point_lookup_of_an_unknown_run_raises_key_error_with_its_identifier(tmp_path) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(KeyError) as error:
+            store.get("unknown-run")
+
+    assert error.value.args == ("unknown-run",)
+
+
