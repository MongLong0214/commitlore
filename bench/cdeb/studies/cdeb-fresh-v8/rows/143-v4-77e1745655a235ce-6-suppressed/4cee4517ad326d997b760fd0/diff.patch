+    def _manifest_entry_names(self, files: FetchedFiles) -> frozenset[str]:
+        """Return normalized declared names, never arbitrary manifest prose."""
+        entries: set[str] = set()
+        for path, text in files.files:
+            manifest = path.rsplit("/", 1)[-1]
+            if manifest == "package.json":
+                entries.update(_package_json_entries(text))
+            elif manifest in {"pyproject.toml", "Cargo.toml"}:
+                entries.update(_toml_entries(text))
+            elif manifest == "go.mod":
+                entries.update(_go_mod_entries(text))
+            elif manifest == "requirements.txt":
+                entries.update(_requirements_entries(text))
+        return frozenset(entries)
 
     def _producer_name(self, producer) -> str:
         return producer.__name__.removeprefix("_")
 
 
+def _normalize_entry(name: str) -> str:
+    """Use package-name normalization while retaining exact-name matching."""
+    return re.sub(r"[-_.]+", "-", name.strip().lower())
+
+
+def _package_json_entries(text: str) -> frozenset[str]:
+    try:
+        manifest = json.loads(text)
+    except (TypeError, ValueError):
+        return frozenset()
+
+    entries: set[str] = set()
+
+    def visit(value: object) -> None:
+        if not isinstance(value, dict):
+            return
+        for key, child in value.items():
+            entries.add(_normalize_entry(key))
+            visit(child)
+
+    visit(manifest)
+    return frozenset(entries)
+
+
+def _toml_entries(text: str) -> frozenset[str]:
+    text = _toml_code(text)
+    entries: set[str] = set()
+    for match in re.finditer(r"(?m)^\s*\[\[?([^\]]+)\]?\]\s*$", text):
+        entries.add(_normalize_entry(match.group(1).rsplit(".", 1)[-1].strip(" \t\"'")))
+    for match in re.finditer(r"(?m)^\s*(?:\"([^\"]+)\"|'([^']+)'|([A-Za-z0-9_-]+))\s*=", text):
+        entries.add(_normalize_entry(next(part for part in match.groups() if part is not None)))
+    for match in re.finditer(r"(?ms)^\s*(?:\"?[-A-Za-z0-9_.]+\"?\.)?dependencies\s*=\s*\[(.*?)\]", text):
+        entries.update(_requirement_name(item) for item in _quoted_values(match.group(1)))
+    return frozenset(entries)
+
+
+def _go_mod_entries(text: str) -> frozenset[str]:
+    entries: set[str] = set()
+    in_require_block = False
+    text = re.sub(r"(?s)/\*.*?\*/", "", text)
+    for raw_line in text.splitlines():
+        line = _strip_comments(raw_line, "//").strip()
+        if not line:
+            continue
+        if line == ")":
+            in_require_block = False
+            continue
+        if line.startswith("require ("):
+            in_require_block = True
+            continue
+        if line.startswith("require "):
+            entries.add(_normalize_entry(line.removeprefix("require ").split()[0]))
+        elif in_require_block:
+            entries.add(_normalize_entry(line.split()[0]))
+    return frozenset(entries)
+
+
+def _requirements_entries(text: str) -> frozenset[str]:
+    entries: set[str] = set()
+    for raw_line in text.splitlines():
+        line = _strip_comments(raw_line, "#").strip()
+        if not line or line.startswith(("-", ".")):
+            continue
+        name = _requirement_name(line)
+        if name:
+            entries.add(name)
+    return frozenset(entries)
+
+
+def _strip_comments(text: str, marker: str) -> str:
+    quote = ""
+    escaped = False
+    result: list[str] = []
+    for index, character in enumerate(text):
+        if escaped:
+            result.append(character)
+            escaped = False
+        elif character == "\\" and quote:
+            result.append(character)
+            escaped = True
+        elif character in {"\"", "'"}:
+            quote = "" if quote == character else character if not quote else quote
+            result.append(character)
+        elif text.startswith(marker, index) and not quote:
+            break
+        else:
+            result.append(character)
+    return "".join(result)
+
+
+def _toml_code(text: str) -> str:
+    """Remove TOML comments and multiline-string bodies before matching keys."""
+    lines: list[str] = []
+    delimiter = ""
+    for raw_line in text.splitlines():
+        if delimiter:
+            closing = raw_line.find(delimiter)
+            if closing < 0:
+                continue
+            raw_line = raw_line[closing + len(delimiter) :]
+            delimiter = ""
+        line = _strip_comments(raw_line, "#")
+        starts = [(line.find(mark), mark) for mark in ('\"\"\"', "'''") if line.find(mark) >= 0]
+        if starts:
+            position, marker = min(starts)
+            closing = line.find(marker, position + len(marker))
+            if closing < 0:
+                delimiter = marker
+                line = line[:position]
+            else:
+                line = line[:position] + line[closing + len(marker) :]
+        lines.append(line)
+    return "\n".join(lines)
+
+
+def _quoted_values(text: str) -> tuple[str, ...]:
+    return tuple(first or second for first, second in re.findall(r'"([^\"]*)"|\'([^\']*)\'', text))
+
+
+def _requirement_name(value: str) -> str:
+    match = re.match(r"\s*([A-Za-z0-9_.-]+)", value)
+    return _normalize_entry(match.group(1)) if match else ""
+
+
 DEFAULT_EVIDENCE_READER: Final = FileEvidenceReader()
 
 
