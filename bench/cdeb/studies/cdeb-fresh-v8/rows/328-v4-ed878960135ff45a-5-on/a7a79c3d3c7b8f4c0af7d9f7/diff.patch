+def test_observations_order_backfilled_runs_by_recorded_time(tmp_path) -> None:
+    # Given: a newer observation is stored before an older backfill, then a tie.
+    earlier = datetime(2026, 7, 26, 12, 0, tzinfo=timezone.utc)
+    later = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("newer", artifact(stars=4, at=later))
+        store.save("backfilled", artifact(stars=2, at=earlier))
+        store.save("same-time", artifact(stars=9, at=later))
+
+        # When: the observation history is read.
+        observations = store.observations()
+
+    # Then: recorded time is primary and recording sequence breaks ties.
+    assert [(item.run_id, item.observed_at, item.stars) for item in observations] == [
+        ("backfilled", earlier, 2),
+        ("newer", later, 4),
+        ("same-time", later, 9),
+    ]
+
+
