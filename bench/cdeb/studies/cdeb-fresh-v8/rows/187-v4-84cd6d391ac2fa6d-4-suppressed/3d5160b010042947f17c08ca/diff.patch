+def test_point_lookup_returns_a_correction_with_its_lineage(tmp_path) -> None:
+    # Given: a correction is stored after the run it corrects.
+    correction = artifact()
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("run-1", artifact())
+        store.save("run-2", correction, corrects_run_id="run-1")
+
+        # When: the correction is retrieved directly, without enumerating history.
+        stored = store.get("run-2")
+
+    # Then: the correction's own artifact and correction target are both available.
+    assert stored.run_id == "run-2"
+    assert stored.corrects_run_id == "run-1"
+    assert stored.artifact.to_bytes() == correction.to_bytes()
+
+
+def test_point_lookup_of_an_unknown_run_raises_key_error_with_its_identifier(tmp_path) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(KeyError) as error:
+            store.get("missing-run")
+
+    assert error.value.args == ("missing-run",)
+
