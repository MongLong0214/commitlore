diff --git a/tests/test_seam.py b/tests/test_seam.py
index cc155de..b966294 100644
--- a/tests/test_seam.py
+++ b/tests/test_seam.py
@@ -381,3 +381,104 @@ def test_broken_category_reader_does_not_change_the_approval_inputs() -> None:
     assert artifact.scores[0].recommendation.status.value == "review"
     assert artifact.repositories[0].categories[0].basis is ClaimBasis.ABSENT
     assert any(failure.port == "category" for failure in artifact.failures)
+
+
+def test_category_pack_support_is_checked_before_operational_ports() -> None:
+    events = []
+
+    class IncompleteEvidence:
+        evidence_names = frozenset({"files"})
+
+    class UnexpectedPort:
+        def __getattr__(self, name):
+            events.append(name)
+            raise AssertionError(f"operational port accessed: {name}")
+
+    with pytest.raises(
+        ValueError,
+        match="category pack 'coding-agents' names unavailable evidence: source",
+    ):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(
+                UnexpectedPort(),
+                UnexpectedPort(),
+                UnexpectedPort(),
+                UnexpectedPort(),
+                IncompleteEvidence(),
+            ),
+            model_smoke=SmokeResult(True, "fixture"),
+        )
+
+    assert events == []
+
+
+def test_unreadable_category_reader_records_its_complete_vocabulary_as_absent() -> None:
+    class CustomEvidence:
+        evidence_names = frozenset({"files", "source", "webhooks"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise RuntimeError("custom category reader deliberately unavailable")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(Repository(), Files(), Model(), Clock(), CustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+    trace = artifact.repositories[0]
+
+    assert {(item.evidence, item.values, item.basis) for item in trace.category_evidence} == {
+        ("files", frozenset(), ClaimBasis.ABSENT),
+        ("source", frozenset(), ClaimBasis.ABSENT),
+        ("webhooks", frozenset(), ClaimBasis.ABSENT),
+    }
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
+    assert trace.categories[0].missing_evidence == ("files", "source")
+
+
+def test_unreadable_files_record_configured_category_vocabulary_as_absent() -> None:
+    class CustomEvidence:
+        evidence_names = frozenset({"files", "source", "webhooks"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("evidence reader must not receive unavailable files")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(Repository(), Files(OSError("offline")), Model(), Clock(), CustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+    trace = artifact.repositories[0]
+
+    assert {(item.evidence, item.values, item.basis) for item in trace.category_evidence} == {
+        ("files", frozenset(), ClaimBasis.ABSENT),
+        ("source", frozenset(), ClaimBasis.ABSENT),
+        ("webhooks", frozenset(), ClaimBasis.ABSENT),
+    }
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
+
+
+def test_incomplete_files_record_configured_category_vocabulary_as_absent() -> None:
+    class IncompleteFiles(Files):
+        def read(self, candidate: Candidate) -> FetchedFiles:
+            return FetchedFiles((("main.py", "x = 1\n"),), complete=False)
+
+    class CustomEvidence:
+        evidence_names = frozenset({"files", "source", "webhooks"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("evidence reader must not receive incomplete files")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(Repository(), IncompleteFiles(), Model(), Clock(), CustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+    trace = artifact.repositories[0]
+
+    assert {(item.evidence, item.values, item.basis) for item in trace.category_evidence} == {
+        ("files", frozenset(), ClaimBasis.ABSENT),
+        ("source", frozenset(), ClaimBasis.ABSENT),
+        ("webhooks", frozenset(), ClaimBasis.ABSENT),
+    }
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
