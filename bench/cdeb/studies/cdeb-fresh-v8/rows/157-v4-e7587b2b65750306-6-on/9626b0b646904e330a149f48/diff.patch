+type PublicMetricConsumer = Pick<MetricDefinition, "observation_key">;
+type IsAssignableToPublicConsumer<Value> = [Value] extends [PublicMetricConsumer] ? true : false;
+type Expect<Condition extends true> = Condition;
+type Not<Condition extends boolean> = Condition extends true ? false : true;
+type IsAny<Value> = 0 extends (1 & Value) ? true : false;
+type IsExactlyString<Value> = IsAny<Value> extends true
+  ? false
+  : [Value] extends [string]
+    ? [string] extends [Value]
+      ? true
+      : false
+    : false;
+
+type _ObservationKeyIsRequiredString = Expect<IsExactlyString<MetricDefinition["observation_key"]>>;
+type _MissingObservationKeyIsRejected = Expect<Not<IsAssignableToPublicConsumer<{}>>>;
+type _OptionalObservationKeyIsRejected = Expect<
+  Not<IsAssignableToPublicConsumer<{ observation_key?: string }>>
+>;
+type _UnknownObservationKeyIsRejected = Expect<Not<IsAssignableToPublicConsumer<unknown>>>;
+type _UntypedObservationKeyIsRejected = Expect<
+  Not<IsAssignableToPublicConsumer<Record<string, unknown>>>
+>;
+
