+def test_observations_limit_returns_the_latest_derived_records_in_append_order(tmp_path) -> None:
+    # Given: persisted artifacts have produced three repository observations.
+    times = tuple(datetime(2026, 7, day, 12, 0, tzinfo=timezone.utc) for day in (27, 28, 29))
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for number, (stars, observed_at) in enumerate(zip((4, 9, 16), times), start=1):
+            store.save(f"run-{number}", artifact(stars=stars, at=observed_at))
+
+        # When: callers request a smaller recent observation window.
+        observations = store.observations(limit=2)
+        complete_observations = store.observations()
+
+    # Then: derived observations retain chronological append order and their values,
+    # while the default continues to return complete history.
+    assert [(item.run_id, item.observed_at, item.stars) for item in observations] == [
+        ("run-2", times[1], 9),
+        ("run-3", times[2], 16),
+    ]
+    assert [item.run_id for item in complete_observations] == ["run-1", "run-2", "run-3"]
+
+
+@pytest.mark.parametrize("method_name", ["history", "observations"])
+def test_bounded_store_reads_require_a_positive_limit(tmp_path, method_name: str) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        method = getattr(store, method_name)
+
+        with pytest.raises(ValueError, match="limit must be positive"):
+            method(limit=0)
+
