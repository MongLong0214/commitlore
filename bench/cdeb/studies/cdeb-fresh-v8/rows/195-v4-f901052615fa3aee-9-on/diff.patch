+def test_history_limit_returns_the_latest_stored_artifacts_in_append_order(tmp_path) -> None:
+    # Given: three complete artifacts have been appended to persistent storage.
+    recorded = tuple(artifact(stars=stars) for stars in (4, 9, 16))
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for number, value in enumerate(recorded, start=1):
+            store.save(f"run-{number}", value)
+
+        # When: callers request a smaller recent history window.
+        history = store.history(limit=2)
+        complete_history = store.history()
+
+    # Then: the window retains chronological append order and real artifacts,
+    # while the default continues to return complete history.
+    assert [(run.run_id, run.artifact.to_bytes()) for run in history] == [
+        ("run-2", recorded[1].to_bytes()),
+        ("run-3", recorded[2].to_bytes()),
+    ]
+    assert [run.run_id for run in complete_history] == ["run-1", "run-2", "run-3"]
+
