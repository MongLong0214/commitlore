+def test_unreadable_repository_files_use_the_configured_evidence_vocabulary() -> None:
+    class CustomEvidence:
+        evidence_names = frozenset({"files", "source", "repository_topics"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("evidence reader must not run without files")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(Repository(), Files(OSError("offline")), Model(), Clock(), CustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+
+    trace = artifact.repositories[0]
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
+    assert trace.categories[0].missing_evidence == ("files", "source")
+    assert {item.evidence for item in trace.category_evidence} == {
+        "files",
+        "source",
+        "repository_topics",
+    }
+    assert all(item.values == frozenset() and item.basis is ClaimBasis.ABSENT for item in trace.category_evidence)
+
+
+def test_unsupported_category_pack_fails_before_operational_ports_are_invoked() -> None:
+    calls: list[str] = []
+
+    class RecordingRepository:
+        def search(self, query, limit):
+            calls.append("repository.search")
+            return CollectResult()
+
+        def metadata(self, candidate, at):
+            calls.append("repository.metadata")
+            return RepositoryMetadata(ScoreInputs(True, True, True))
+
+    class RecordingFiles:
+        def read(self, candidate):
+            calls.append("files.read")
+            return FetchedFiles(())
+
+    class RecordingModel:
+        def evaluate(self, digest):
+            calls.append("model.evaluate")
+            return GradeResult(8, 7, "", "", 0.0, "")
+
+        def flags_malicious(self, digest):
+            calls.append("model.flags_malicious")
+            return False
+
+    class RecordingClock:
+        def now(self):
+            calls.append("clock.now")
+            return AT
+
+    class IncompleteEvidence:
+        evidence_names = frozenset({"files"})
+
+        def read_evidence(self, candidate, files, metadata):
+            calls.append("evidence.read_evidence")
+            return ()
+
+    with pytest.raises(ValueError, match="category pack 'coding-agents' names unavailable evidence: source"):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(RecordingRepository(), RecordingFiles(), RecordingModel(), RecordingClock(), IncompleteEvidence()),
+        )
+
+    assert calls == []
