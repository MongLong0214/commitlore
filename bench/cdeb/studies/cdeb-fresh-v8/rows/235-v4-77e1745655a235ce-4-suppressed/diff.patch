 from dataclasses import dataclass
 from typing import TYPE_CHECKING, Final
@@ -12,6 +13,16 @@ if TYPE_CHECKING:
     from .ports import RepositoryMetadata
 
 
+MANIFEST_FILENAMES: Final = frozenset(
+    {"package.json", "pyproject.toml", "Cargo.toml", "go.mod", "requirements.txt"}
+)
+_NAME_NORMALIZATION: Final = re.compile(r"[-_.]+")
+_TOML_KEY: Final = re.compile(r"^\s*([A-Za-z0-9_-]+)\s*=")
+_TOML_TABLE: Final = re.compile(r"^\s*\[([^]]+)\]")
+_GO_REQUIRE: Final = re.compile(r"^\s*require\s+(?:\(\s*)?([^\s()]+)")
+_REQUIREMENT_NAME: Final = re.compile(r"^\s*([A-Za-z0-9_.-]+)")
+
+
 @dataclass(frozen=True)  # noqa: SLOTS_OK -- dataclass slots require Python 3.10.
 class EvidenceRequirement:
