@@ -75,17 +86,145 @@ class FileEvidenceReader:
             basis,
         )
 
-    def _manifest(self, files: FetchedFiles) -> str:
-        return "\n".join(
-            text.lower()
-            for path, text in files.files
-            if path.rsplit("/", 1)[-1] in {"package.json", "pyproject.toml", "Cargo.toml", "go.mod", "requirements.txt"}
-        )
+    def _manifest_entry_names(self, files: FetchedFiles) -> frozenset[str]:
+        entries: set[str] = set()
+        for path, text in files.files:
+            filename = path.rsplit("/", 1)[-1]
+            if filename not in MANIFEST_FILENAMES:
+                continue
+            if filename == "package.json":
+                entries.update(_package_json_entries(text))
+            elif filename in {"pyproject.toml", "Cargo.toml"}:
+                entries.update(_toml_entries(text))
+            elif filename == "go.mod":
+                entries.update(_go_mod_entries(text))
+            elif filename == "requirements.txt":
+                entries.update(_requirements_entries(text))
+        return frozenset(entries)
 
     def _producer_name(self, producer) -> str:
         return producer.__name__.removeprefix("_")
 
 
+def _normalized_entry_name(name: str) -> str:
+    return _NAME_NORMALIZATION.sub("-", name.strip().lower())
+
+
+def _package_json_entries(text: str) -> set[str]:
+    try:
+        manifest = json.loads(text)
+    except json.JSONDecodeError:
+        return set()
+    if not isinstance(manifest, dict):
+        return set()
+    return {
+        _normalized_entry_name(name)
+        for name in _json_entry_names(manifest)
+    }
+
+
+def _json_entry_names(value: object) -> set[str]:
+    if not isinstance(value, dict):
+        return set()
+    entries = set(value)
+    for nested in value.values():
+        entries.update(_json_entry_names(nested))
+    return entries
+
+
+def _toml_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    in_dependency_table = False
+    collecting_dependency_values = False
+    for line in text.splitlines():
+        uncommented = _without_toml_comment(line)
+        table = _TOML_TABLE.match(uncommented)
+        if table:
+            table_name = table.group(1).strip().strip('"\'')
+            table_parts = [_normalized_entry_name(part.strip().strip('"\'')) for part in table_name.split(".")]
+            entries.update(table_parts)
+            in_dependency_table = "dependencies" in table_parts or "requires" in table_parts
+            collecting_dependency_values = False
+            continue
+        key = _TOML_KEY.match(uncommented)
+        if not key:
+            if collecting_dependency_values:
+                entries.update(_dependency_entry_name(value) for value in _quoted_values(uncommented))
+                if "]" in uncommented:
+                    collecting_dependency_values = False
+            continue
+        key_name = _normalized_entry_name(key.group(1))
+        entries.add(key_name)
+        if key_name in {"dependencies", "requires"} or in_dependency_table:
+            entries.update(_dependency_entry_name(value) for value in _quoted_values(uncommented))
+            collecting_dependency_values = "[" in uncommented and "]" not in uncommented
+    return entries
+
+
+def _without_toml_comment(line: str) -> str:
+    quoted = False
+    quote = ""
+    for index, character in enumerate(line):
+        if character in {'"', "'"}:
+            if not quoted:
+                quoted, quote = True, character
+            elif character == quote:
+                quoted = False
+        elif character == "#" and not quoted:
+            return line[:index]
+    return line
+
+
+def _quoted_values(line: str) -> tuple[str, ...]:
+    return tuple(match.group(2) for match in re.finditer(r"(['\"])(.*?)\1", line))
+
+
+def _dependency_entry_name(value: str) -> str:
+    match = _REQUIREMENT_NAME.match(value)
+    return _normalized_entry_name(match.group(1)) if match else _normalized_entry_name(value)
+
+
+def _go_mod_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    in_require_block = False
+    in_comment = False
+    for line in text.splitlines():
+        if in_comment:
+            if "*/" in line:
+                in_comment = False
+            continue
+        if line.lstrip().startswith("/*"):
+            in_comment = "*/" not in line
+            continue
+        uncommented = line.split("//", 1)[0]
+        if re.match(r"^\s*require\s*\(\s*$", uncommented):
+            in_require_block = True
+            continue
+        require = _GO_REQUIRE.match(uncommented)
+        if require:
+            entries.add(_normalized_entry_name(require.group(1)))
+            in_require_block = "(" in uncommented
+        elif in_require_block and uncommented.strip() == ")":
+            in_require_block = False
+        elif in_require_block:
+            name = uncommented.split(maxsplit=1)
+            if name:
+                entries.add(_normalized_entry_name(name[0]))
+    return entries
+
+
+def _requirements_entries(text: str) -> set[str]:
+    entries: set[str] = set()
+    for line in text.splitlines():
+        requirement = line.split("#", 1)[0].strip()
+        if not requirement or requirement.startswith(("-", "--")):
+            continue
+        name = _REQUIREMENT_NAME.match(requirement)
+        if name:
+            entries.add(_normalized_entry_name(name.group(1)))
+    return entries
+
+
 DEFAULT_EVIDENCE_READER: Final = FileEvidenceReader()
 
 
