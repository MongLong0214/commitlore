+def test_get_returns_the_stored_correction_and_its_lineage(tmp_path) -> None:
+    # Given: a correction is stored after the run it corrects.
+    original = artifact(Files(OSError("offline")))
+    correction = artifact()
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("run-1", original)
+        store.save("run-2", correction, corrects_run_id="run-1")
+
+        # When: the correction is retrieved by its known identifier.
+        stored = store.get("run-2")
+
+        # Then: it returns the correction itself and its immutable lineage.
+        assert stored.run_id == "run-2"
+        assert stored.corrects_run_id == "run-1"
+        assert stored.artifact.to_bytes() == correction.to_bytes()
+
+
+def test_get_raises_key_error_for_an_unknown_run(tmp_path) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(KeyError, match="missing-run"):
+            store.get("missing-run")
+
