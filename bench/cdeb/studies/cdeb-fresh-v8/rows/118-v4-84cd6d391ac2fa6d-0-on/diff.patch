             raise KeyError(run_id)
         return RunArtifact.from_bytes(bytes(row[0]))
 
+    def get(self, run_id: str) -> StoredRun:
+        row = self._connection.execute(
+            "SELECT run_id, corrects_run_id, artifact FROM run_artifacts WHERE run_id = ?", (run_id,)
+        ).fetchone()
+        if row is None:
+            raise KeyError(run_id)
+        stored_run_id, corrects_run_id, artifact = row
+        return StoredRun(
+            str(stored_run_id),
+            None if corrects_run_id is None else str(corrects_run_id),
+            RunArtifact.from_bytes(bytes(artifact)),
+        )
+
     def history(self) -> tuple[StoredRun, ...]:
         return tuple(
             StoredRun(str(run_id), corrects_run_id, RunArtifact.from_bytes(bytes(artifact)))
