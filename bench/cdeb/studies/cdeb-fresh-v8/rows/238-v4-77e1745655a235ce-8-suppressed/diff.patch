@@ -89,6 +103,134 @@ class FileEvidenceReader:
 DEFAULT_EVIDENCE_READER: Final = FileEvidenceReader()
 
 
+_PACKAGE_DEPENDENCY_FIELDS: Final = frozenset(
+    {
+        "dependencies",
+        "devDependencies",
+        "optionalDependencies",
+        "peerDependencies",
+        "bundledDependencies",
+        "bundleDependencies",
+        "overrides",
+        "resolutions",
+    }
+)
+_TOML_DEPENDENCY_SECTIONS: Final = frozenset({"dependencies", "dev-dependencies", "build-dependencies"})
+_TOML_STRING: Final = re.compile(r'''"((?:[^"\\]|\\.)*)"|'([^']*)' ''', re.VERBOSE)
+_TOML_KEY: Final = re.compile(r'''^\s*(?:"(?P<double>(?:[^"\\]|\\.)*)"|'(?P<single>[^']*)'|(?P<bare>[A-Za-z0-9_-]+))\s*=''')
+_TOML_TABLE: Final = re.compile(r"^\s*\[\s*(.+?)\s*\]\s*(?:#.*)?$")
+_DEPENDENCY_NAME: Final = re.compile(r"^\s*([A-Za-z0-9][A-Za-z0-9._-]*)")
+
+
+def _normalise_entry_name(name: str) -> str:
+    """Use the conventional package-name normalization for exact matching."""
+    return re.sub(r"[-_.]+", "-", name).lower()
+
+
+def _package_json_entry_names(text: str) -> set[str]:
+    try:
+        document = json.loads(text)
+    except json.JSONDecodeError:
+        return set()
+    if not isinstance(document, Mapping):
+        return set()
+
+    names: set[str] = set()
+    for field in _PACKAGE_DEPENDENCY_FIELDS | {"config"}:
+        entries = document.get(field)
+        if isinstance(entries, Mapping):
+            names.update(str(name) for name in entries)
+        elif field in {"bundledDependencies", "bundleDependencies"} and isinstance(entries, list):
+            names.update(item for item in entries if isinstance(item, str))
+    return names
+
+
+def _toml_entry_names(text: str) -> set[str]:
+    """Read dependency and tool/configuration keys without treating TOML prose as names.
+
+    The project supports Python 3.9, whose standard library has no TOML parser.
+    These manifests need only their table/key structure and quoted dependency
+    strings, so a deliberately small reader keeps that compatibility without
+    widening evidence to arbitrary text.
+    """
+    names: set[str] = set()
+    lines = iter(text.splitlines())
+    section: tuple[str, ...] = ()
+    for line in lines:
+        table = _TOML_TABLE.match(line)
+        if table:
+            section = tuple(_toml_table_part(part) for part in table.group(1).split("."))
+            if section[:1] == ("tool",) and len(section) > 1:
+                names.add(section[-1])
+            continue
+
+        key = _TOML_KEY.match(line)
+        if not key:
+            continue
+        entry = next(value for value in key.group("double", "single", "bare") if value is not None)
+        value = line[key.end() :]
+
+        if section and section[-1] in _TOML_DEPENDENCY_SECTIONS:
+            names.add(entry)
+        elif section == ("project",) and _normalise_entry_name(entry) == "dependencies":
+            names.update(_toml_dependency_values(value, lines))
+        elif section == ("project", "optional-dependencies"):
+            names.update(_toml_dependency_values(value, lines))
+        elif section[:1] in {("tool",), ("features",)}:
+            names.add(entry)
+    return names
+
+
+def _toml_table_part(part: str) -> str:
+    return part.strip().strip('"\'')
+
+
+def _toml_dependency_values(value: str, following_lines) -> set[str]:
+    while "]" not in value:
+        try:
+            value += "\n" + next(following_lines)
+        except StopIteration:
+            return set()
+    return {
+        dependency.group(1)
+        for match in _TOML_STRING.finditer(value)
+        if (dependency := _DEPENDENCY_NAME.match(match.group(1) or match.group(2)))
+    }
+
+
+def _go_mod_dependency_names(text: str) -> set[str]:
+    names: set[str] = set()
+    in_require_block = False
+    for raw_line in text.splitlines():
+        line = raw_line.split("//", 1)[0].strip()
+        if line == "require (":
+            in_require_block = True
+            continue
+        if in_require_block and line == ")":
+            in_require_block = False
+            continue
+        if line.startswith("require "):
+            line = line.removeprefix("require ")
+        elif not in_require_block:
+            continue
+        dependency = line.split(maxsplit=1)
+        if dependency:
+            names.add(dependency[0])
+    return names
+
+
+def _requirements_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    for raw_line in text.splitlines():
+        line = raw_line.split("#", 1)[0].strip()
+        if line.startswith(("-", "http:", "https:")):
+            continue
+        match = _DEPENDENCY_NAME.match(line)
+        if match:
+            names.add(match.group(1))
+    return names
+
+
