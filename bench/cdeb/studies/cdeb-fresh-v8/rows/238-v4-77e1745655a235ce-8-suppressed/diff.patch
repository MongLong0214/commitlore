+@pytest.mark.parametrize(
+    ("path", "manifest"),
+    (
+        ("package.json", '{"dependencies": {"MCP": "1", "OLLAMA": "1"}}'),
+        ("pyproject.toml", '[project]\ndependencies = ["MCP>=1", "OLLAMA>=1"]'),
+        ("Cargo.toml", '[dependencies]\nMCP = "1"\nOLLAMA = "1"'),
+        ("go.mod", "require (\n  MCP v1.0.0\n  OLLAMA v1.0.0\n)"),
+        ("requirements.txt", "MCP>=1\nOLLAMA==1"),
+    ),
+)
+def test_manifest_entry_names_produce_category_evidence(path: str, manifest: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, manifest),)),
+        None,
+    )
+
+    assert {item.evidence: item.values for item in evidence} >= {
+        "manifest_entries": frozenset({"mcp"}),
+        "dependencies": frozenset({"ollama"}),
+    }
+
+
