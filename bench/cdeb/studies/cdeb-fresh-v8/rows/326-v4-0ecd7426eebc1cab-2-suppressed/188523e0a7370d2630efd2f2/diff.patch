+def test_unsupported_category_reader_fails_before_any_operational_port() -> None:
+    calls: list[str] = []
+
+    class UnexpectedPort:
+        def __getattr__(self, name):
+            def called(*args, **kwargs):
+                calls.append(name)
+                raise AssertionError(f"{name} must not be called")
+
+            return called
+
+    class FilesOnlyEvidence:
+        evidence_names = frozenset({"files"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("evidence must not be read")
+
+    with pytest.raises(ValueError, match="category pack 'coding-agents' names unavailable evidence: source"):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(UnexpectedPort(), UnexpectedPort(), UnexpectedPort(), UnexpectedPort(), FilesOnlyEvidence()),
+        )
+
+    assert calls == []
+
