+def test_observations_order_by_recorded_time_then_recording_sequence(tmp_path) -> None:
+    # Given: a newer observation is recorded before an older backfilled run.
+    older = datetime(2026, 7, 26, 12, 0, tzinfo=timezone.utc)
+    newer = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("newer-first", artifact(stars=9, at=newer))
+        store.save("newer-second", artifact(stars=10, at=newer))
+
+        # When: an older recorded observation is saved afterwards.
+        store.save("older", artifact(stars=4, at=older))
+        observations = store.observations()
+
+    # Then: chronological order wins, while equal times retain recording order.
+    assert tuple((item.run_id, item.observed_at, item.stars) for item in observations) == (
+        ("older", older, 4),
+        ("newer-first", newer, 9),
+        ("newer-second", newer, 10),
+    )
+
+
