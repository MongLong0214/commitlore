@@ -89,6 +91,170 @@ class FileEvidenceReader:
 DEFAULT_EVIDENCE_READER: Final = FileEvidenceReader()
 
 
+def _normalize_entry_name(name: str) -> str:
+    return re.sub(r"[-_.]+", "-", name).lower()
+
+
+def _package_json_entry_names(text: str) -> set[str]:
+    try:
+        manifest = json.loads(text)
+    except json.JSONDecodeError:
+        return set()
+    if not isinstance(manifest, dict):
+        return set()
+
+    names: set[str] = set()
+    for field in ("dependencies", "devDependencies", "optionalDependencies", "peerDependencies"):
+        entries = manifest.get(field)
+        if isinstance(entries, dict):
+            names.update(name for name in entries if isinstance(name, str))
+    bundled = manifest.get("bundledDependencies")
+    if isinstance(bundled, list):
+        names.update(name for name in bundled if isinstance(name, str))
+    config = manifest.get("config")
+    if isinstance(config, dict):
+        names.update(name for name in config if isinstance(name, str))
+    return names
+
+
+_DEPENDENCY_TOML_SECTIONS: Final = re.compile(
+    r"^(?:dependencies|dev-dependencies|build-dependencies|workspace\.dependencies|target\..+\.dependencies)$"
+)
+_TOML_TABLE: Final = re.compile(r"^\s*\[([^]]+)]\s*(?:#.*)?$")
+_TOML_KEY: Final = re.compile(r"^\s*([A-Za-z0-9_-]+)\s*=")
+_TOML_STRINGS: Final = re.compile(r'''["']([^"']+)["']''')
+
+
+def _toml_entry_names(text: str, *, pyproject: bool) -> set[str]:
+    names: set[str] = set()
+    section = ""
+    collecting_dependencies = False
+    dependency_values: list[str] = []
+
+    def finish_dependencies() -> None:
+        nonlocal collecting_dependencies
+        names.update(_requirement_name(value) for value in dependency_values)
+        dependency_values.clear()
+        collecting_dependencies = False
+
+    for line in text.splitlines():
+        line = _toml_without_comment(line)
+        table = _TOML_TABLE.match(line)
+        if table:
+            if collecting_dependencies:
+                finish_dependencies()
+            section = table.group(1).strip()
+            if pyproject and section.startswith("tool."):
+                names.add(section.split(".", 2)[1])
+            elif not pyproject:
+                dependency_table = re.fullmatch(
+                    r"(?:dependencies|dev-dependencies|build-dependencies|workspace\.dependencies|target\..+\.dependencies)\.([A-Za-z0-9_-]+)",
+                    section,
+                )
+                if dependency_table:
+                    names.add(dependency_table.group(1))
+            continue
+
+        if collecting_dependencies:
+            dependency_values.extend(_TOML_STRINGS.findall(line))
+            if "]" in line:
+                finish_dependencies()
+            continue
+
+        key = _TOML_KEY.match(line)
+        if not key:
+            continue
+        entry = key.group(1)
+        value = line[key.end() :]
+        dependency_list = pyproject and (
+            (section == "project" and entry == "dependencies")
+            or section == "project.optional-dependencies"
+        )
+        if dependency_list:
+            dependency_values.extend(_TOML_STRINGS.findall(value))
+            if "]" not in value:
+                collecting_dependencies = True
+            else:
+                finish_dependencies()
+        elif not pyproject and _DEPENDENCY_TOML_SECTIONS.fullmatch(section):
+            names.add(entry)
+        elif pyproject and section.startswith("tool."):
+            names.add(entry)
+    if collecting_dependencies:
+        finish_dependencies()
+    return names
+
+
+def _toml_without_comment(line: str) -> str:
+    quote = ""
+    escaped = False
+    for index, character in enumerate(line):
+        if quote:
+            if escaped:
+                escaped = False
+            elif character == "\\" and quote == '"':
+                escaped = True
+            elif character == quote:
+                quote = ""
+        elif character in {'"', "'"}:
+            quote = character
+        elif character == "#":
+            return line[:index]
+    return line
+
+
+def _pyproject_entry_names(text: str) -> set[str]:
+    return _toml_entry_names(text, pyproject=True)
+
+
+def _cargo_entry_names(text: str) -> set[str]:
+    return _toml_entry_names(text, pyproject=False)
+
+
+def _go_mod_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    in_require_block = False
+    for line in text.splitlines():
+        content = line.split("//", 1)[0].strip()
+        if content == "require (":
+            in_require_block = True
+            continue
+        if in_require_block and content == ")":
+            in_require_block = False
+            continue
+        if content.startswith("require "):
+            fields = content.removeprefix("require ").split()
+        elif in_require_block:
+            fields = content.split()
+        else:
+            continue
+        if fields:
+            names.add(fields[0])
+    return names
+
+
+def _requirements_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    for line in text.splitlines():
+        requirement = line.split("#", 1)[0].strip()
+        if requirement and not requirement.startswith(("-", "--")):
+            names.add(_requirement_name(requirement))
+    return names
+
+
+def _requirement_name(value: str) -> str:
+    return re.split(r"[\s\[<>=!~;@]", value.strip(), 1)[0]
+
+
+_MANIFEST_ENTRY_EXTRACTORS: Final = {
+    "package.json": _package_json_entry_names,
+    "pyproject.toml": _pyproject_entry_names,
+    "Cargo.toml": _cargo_entry_names,
+    "go.mod": _go_mod_entry_names,
+    "requirements.txt": _requirements_entry_names,
+}
+
+
 def satisfiable_evidence(reader: FileEvidenceReader = DEFAULT_EVIDENCE_READER) -> frozenset[str]:
     return reader.evidence_names
 
