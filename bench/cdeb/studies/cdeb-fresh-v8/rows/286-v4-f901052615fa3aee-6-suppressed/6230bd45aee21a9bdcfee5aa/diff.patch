+def test_history_limit_returns_recent_persisted_runs_in_append_order(tmp_path) -> None:
+    # Given: three artifacts were appended to a durable store.
+    path = tmp_path / "runs.db"
+    artifacts = (
+        artifact(stars=4, at=AT),
+        artifact(stars=9, at=datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)),
+        artifact(stars=16, at=datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc)),
+    )
+    with SQLiteRunStore(path) as store:
+        for number, recorded in enumerate(artifacts, start=1):
+            store.save(f"run-{number}", recorded)
+
+    # When: history is read after reopening with and without a bound.
+    with SQLiteRunStore(path) as store:
+        complete_history = store.history()
+        recent_history = store.history(limit=2)
+
+    # Then: the complete order remains unchanged and the recent slice remains chronological.
+    assert [stored.run_id for stored in complete_history] == ["run-1", "run-2", "run-3"]
+    assert [stored.artifact.to_bytes() for stored in complete_history] == [
+        recorded.to_bytes() for recorded in artifacts
+    ]
+    assert [stored.run_id for stored in recent_history] == ["run-2", "run-3"]
+    assert [stored.artifact.to_bytes() for stored in recent_history] == [
+        recorded.to_bytes() for recorded in artifacts[1:]
+    ]
+
+
+def test_observations_limit_returns_recent_derived_values_in_append_order(tmp_path) -> None:
+    # Given: three persisted runs each derive an observation for the same repository.
+    path = tmp_path / "runs.db"
+    observations = (
+        ("run-1", AT, 4),
+        ("run-2", datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc), 9),
+        ("run-3", datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc), 16),
+    )
+    with SQLiteRunStore(path) as store:
+        for run_id, observed_at, stars in observations:
+            store.save(run_id, artifact(stars=stars, at=observed_at))
+
+    # When: derived observations are read after reopening with and without a bound.
+    with SQLiteRunStore(path) as store:
+        complete_observations = store.observations()
+        recent_observations = store.observations(limit=2)
+
+    # Then: returned observation values survive and the recent slice remains chronological.
+    assert [
+        (record.run_id, record.repo, record.observed_at, record.stars)
+        for record in complete_observations
+    ] == [(run_id, CANDIDATE.repo, observed_at, stars) for run_id, observed_at, stars in observations]
+    assert [
+        (record.run_id, record.repo, record.observed_at, record.stars)
+        for record in recent_observations
+    ] == [
+        (run_id, CANDIDATE.repo, observed_at, stars)
+        for run_id, observed_at, stars in observations[1:]
+    ]
+
+
+@pytest.mark.parametrize("reader", ["history", "observations"])
+@pytest.mark.parametrize("limit", [0, -1])
+def test_history_read_limits_must_be_positive(tmp_path, reader: str, limit: int) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(ValueError, match="limit must be positive"):
+            getattr(store, reader)(limit=limit)
+
