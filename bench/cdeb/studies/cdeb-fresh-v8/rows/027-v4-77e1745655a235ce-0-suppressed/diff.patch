@@ -214,3 +222,154 @@ def _matches(requirements: tuple[EvidenceRequirement, ...], evidence: tuple[Evid
 
 def _unique(values: tuple[str, ...]) -> tuple[str, ...]:
     return tuple(dict.fromkeys(values))
+
+
+def _package_json_entry_names(text: str) -> set[str]:
+    try:
+        manifest = json.loads(text)
+    except json.JSONDecodeError:
+        return set()
+    if not isinstance(manifest, dict):
+        return set()
+
+    names = _json_object_keys(manifest)
+    for field in ("bundledDependencies", "bundleDependencies"):
+        dependencies = manifest.get(field)
+        if isinstance(dependencies, list):
+            names.update(_requirement_name(item) for item in dependencies if isinstance(item, str))
+    return names
+
+
+def _json_object_keys(value: object) -> set[str]:
+    if isinstance(value, dict):
+        return {
+            _normalized_entry_name(str(key))
+            for key in value
+        }.union(*(_json_object_keys(child) for child in value.values()))
+    if isinstance(value, list):
+        return set().union(*(_json_object_keys(item) for item in value)) if value else set()
+    return set()
+
+
+def _toml_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    section = ""
+    dependency_list = ""
+    collecting_dependencies = False
+
+    for raw_line in text.splitlines():
+        line = _without_toml_comment(raw_line).strip()
+        if not line:
+            continue
+        section_match = re.fullmatch(r"\[\[?\s*([^\]]+?)\s*\]?\]", line)
+        if section_match:
+            section = section_match.group(1).strip().lower()
+            names.update(
+                _normalized_entry_name(part.strip().strip('"\''))
+                for part in section.split(".")
+            )
+            collecting_dependencies = False
+            continue
+
+        key_match = re.match(r"(?:\"([^\"]+)\"|'([^']+)'|([A-Za-z0-9_-]+))\s*=\s*(.*)$", line)
+        if not key_match:
+            if collecting_dependencies:
+                dependency_list += " " + line
+                if "]" in line:
+                    names.update(_requirement_name(item) for item in _toml_strings(dependency_list))
+                    collecting_dependencies = False
+            continue
+
+        key = next(group for group in key_match.groups()[:3] if group is not None)
+        value = key_match.group(4)
+        names.add(_normalized_entry_name(key))
+        if _dependency_list(section, key, value):
+            dependency_list = value
+            collecting_dependencies = "]" not in value
+            if not collecting_dependencies:
+                names.update(_requirement_name(item) for item in _toml_strings(value))
+        elif _dependency_table(section, key, value):
+            names.update(_toml_inline_table_keys(value))
+    return names
+
+
+def _without_toml_comment(line: str) -> str:
+    quote = ""
+    for index, character in enumerate(line):
+        if character in {"'", '"'}:
+            if not quote:
+                quote = character
+            elif quote == character:
+                quote = ""
+        elif character == "#" and not quote:
+            return line[:index]
+    return line
+
+
+def _dependency_list(section: str, key: str, value: str) -> bool:
+    return value.lstrip().startswith("[") and (
+        (section == "project" and key == "dependencies")
+        or section.endswith(("dependencies", "dependency-groups"))
+    )
+
+
+def _dependency_table(section: str, key: str, value: str) -> bool:
+    return section == "tool.poetry" and key == "dependencies" and value.lstrip().startswith("{")
+
+
+def _toml_strings(value: str) -> tuple[str, ...]:
+    return tuple(
+        match.group(1) or match.group(2)
+        for match in re.finditer(r'"([^\"]*)"|\'([^\']*)\'', value)
+    )
+
+
+def _toml_inline_table_keys(value: str) -> set[str]:
+    return {
+        _normalized_entry_name(next(group for group in match.groups() if group is not None))
+        for match in re.finditer(
+            r'(?:\{|,)\s*(?:"([^\"]+)"|\'([^\']+)\'|([A-Za-z0-9_-]+))\s*=',
+            value,
+        )
+    }
+
+
+def _go_mod_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    in_require = False
+    for raw_line in text.splitlines():
+        line = raw_line.split("//", 1)[0].strip()
+        if not line:
+            continue
+        if line == "require (":
+            in_require = True
+            continue
+        if in_require and line == ")":
+            in_require = False
+            continue
+        requirement = (
+            line.removeprefix("require ").strip()
+            if line.startswith("require ")
+            else line if in_require else ""
+        )
+        if requirement:
+            names.add(_requirement_name(requirement.split(maxsplit=1)[0]))
+    return names
+
+
+def _requirements_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    for raw_line in text.splitlines():
+        line = raw_line.split("#", 1)[0].strip()
+        if line and not line.startswith(("-", "--")):
+            names.add(_requirement_name(line))
+    return names
+
+
+def _requirement_name(value: str) -> str:
+    match = re.match(r"\s*([A-Za-z0-9][A-Za-z0-9._-]*)", value)
+    return _normalized_entry_name(match.group(1)) if match else ""
+
+
+def _normalized_entry_name(value: str) -> str:
+    return re.sub(r"[-_.]+", "-", value).casefold()
