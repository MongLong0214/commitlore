@@ -172,3 +172,64 @@ def test_same_version_packs_keep_distinct_identities() -> None:
 
     assert mcp.pack != local_ai.pack
     assert (mcp.pack.name, mcp.pack.version) == ("mcp", "v1")
+
+
+@pytest.mark.parametrize(
+    ("path", "manifest"),
+    (
+        ("package.json", '{"dependencies": {"MCP": "1", "ollama": "1"}}'),
+        ("pyproject.toml", '[project]\ndependencies = ["MCP>=1", "ollama"]'),
+        ("Cargo.toml", '[dependencies]\nMCP = "1"\nollama = "1"'),
+        ("go.mod", "module example.test/app\nrequire (\n  MCP v1.0.0\n  ollama v1.0.0\n)"),
+        ("requirements.txt", "MCP>=1\nollama==1"),
+        ("package.json", '{"config": {"MCP": true, "ollama": true}}'),
+        ("pyproject.toml", "[tool.mcp]\nollama = true"),
+        ("Cargo.toml", "[package.metadata]\nMCP = true\nollama = true"),
+    ),
+)
+def test_manifest_signals_require_exact_declared_entry_names(path: str, manifest: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, manifest),)),
+        None,
+    )
+
+    values = {item.evidence: item.values for item in evidence}
+
+    assert values["manifest_entries"] == frozenset({"mcp"})
+    assert values["dependencies"] == frozenset({"ollama"})
+
+
+@pytest.mark.parametrize(
+    ("path", "manifest"),
+    (
+        (
+            "package.json",
+            '{"description": "mcp ollama", "dependencies": {"mcp-tools": "1", "ollama-client": "1"}}',
