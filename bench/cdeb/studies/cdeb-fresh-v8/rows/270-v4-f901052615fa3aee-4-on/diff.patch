+def test_history_limit_returns_recent_persisted_runs_in_append_order(tmp_path) -> None:
+    # Given: three independently persisted artifacts.
+    first, second, third = artifact(stars=4), artifact(stars=9), artifact(stars=16)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", first)
+        store.save("second", second)
+        store.save("third", third)
+
+        # When: callers request the two most recently appended records.
+        recent = store.history(limit=2)
+
+        # Then: the slice retains chronological append order and full stored values.
+        assert store.history() == (
+            StoredRun("first", None, first),
+            StoredRun("second", None, second),
+            StoredRun("third", None, third),
+        )
+    assert recent == (StoredRun("second", None, second), StoredRun("third", None, third))
+
+
+def test_observations_limit_returns_recent_derived_records_in_append_order(tmp_path) -> None:
+    # Given: persisted artifacts derive a star observation apiece.
+    first_at = AT
+    second_at = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    third_at = datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", artifact(stars=4, at=first_at))
+        store.save("second", artifact(stars=9, at=second_at))
+        store.save("third", artifact(stars=16, at=third_at))
+
+        # When: callers request the two most recently appended observations.
+        recent = store.observations(limit=2)
+
+        # Then: the slice retains chronological append order and full observation values.
+        assert store.observations() == (
+            StoredObservation("first", CANDIDATE.repo, first_at, 4),
+            StoredObservation("second", CANDIDATE.repo, second_at, 9),
+            StoredObservation("third", CANDIDATE.repo, third_at, 16),
+        )
+    assert recent == (
+        StoredObservation("second", CANDIDATE.repo, second_at, 9),
+        StoredObservation("third", CANDIDATE.repo, third_at, 16),
+    )
+
+
+@pytest.mark.parametrize("read", ["history", "observations"])
+@pytest.mark.parametrize("limit", [0, -1])
+def test_recent_store_reads_require_a_positive_limit(tmp_path, read, limit) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(ValueError, match="limit must be positive"):
+            getattr(store, read)(limit=limit)
+
