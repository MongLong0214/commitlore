+def _recent_slice_query(
+    columns: str, table: str, append_key: str, limit: int | None
+) -> tuple[str, tuple[int, ...]]:
+    if limit is None:
+        return f"SELECT {columns} FROM {table} ORDER BY {append_key}", ()
+    if limit <= 0:
+        raise ValueError("limit must be positive")
+    return (
+        f"SELECT {columns} FROM ("
+        f"SELECT {columns}, {append_key} AS append_key FROM {table} "
+        f"ORDER BY {append_key} DESC LIMIT ?"
+        f") ORDER BY append_key",
+        (limit,),
+    )
