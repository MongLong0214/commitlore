+def test_observations_sort_by_recorded_time_then_recording_sequence(tmp_path) -> None:
+    # Given: a backfilled observation is saved after a newer one, followed by a tie.
+    newer = datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("newer", artifact(stars=9, at=newer))
+        store.save("backfilled", artifact(stars=4, at=AT))
+        store.save("same-time", artifact(stars=5, at=AT))
+
+        # When: the observation history is read.
+        observations = store.observations()
+
+    # Then: it is chronological, while equal times retain insert sequence.
+    assert [(observation.run_id, observation.observed_at, observation.stars) for observation in observations] == [
+        ("backfilled", AT, 4),
+        ("same-time", AT, 5),
+        ("newer", newer, 9),
+    ]
+
+
