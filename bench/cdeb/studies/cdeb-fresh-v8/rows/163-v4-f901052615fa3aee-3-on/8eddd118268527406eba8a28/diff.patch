+def test_history_limit_returns_recent_runs_in_append_order(tmp_path) -> None:
+    # Given: three persisted artifacts were appended in sequence.
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", artifact(stars=4))
+        store.save("second", artifact(stars=9))
+        store.save("third", artifact(stars=16))
+
+        # When: callers request a bounded recent history.
+        history = store.history(limit=2)
+
+        # Then: it contains the two newest stored values in their append order.
+        assert [record.run_id for record in history] == ["second", "third"]
+        assert [record.artifact.collection.candidates[0].stars for record in history] == [9, 16]
+        assert [record.run_id for record in store.history()] == ["first", "second", "third"]
+
+
+def test_observations_limit_returns_recent_records_in_append_order(tmp_path) -> None:
+    # Given: three persisted artifacts produced observations at distinct times.
+    times = tuple(datetime(2026, 7, day, 12, 0, tzinfo=timezone.utc) for day in (27, 28, 29))
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for run_id, stars, observed_at in zip(("first", "second", "third"), (4, 9, 16), times):
+            store.save(run_id, artifact(stars=stars, at=observed_at))
+
+        # When: callers request a bounded recent observation history.
+        observations = store.observations(limit=2)
+
+        # Then: it contains the two newest stored values in their append order.
+        assert [(record.run_id, record.observed_at, record.stars) for record in observations] == [
+            ("second", times[1], 9),
+            ("third", times[2], 16),
+        ]
+        assert [record.run_id for record in store.observations()] == ["first", "second", "third"]
+
+
+@pytest.mark.parametrize("method_name", ("history", "observations"))
+def test_store_read_limits_must_be_positive(tmp_path, method_name: str) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        method = getattr(store, method_name)
+        with pytest.raises(ValueError, match="limit must be positive"):
+            method(limit=0)
+
+
