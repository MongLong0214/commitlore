+_PACKAGE_DEPENDENCY_FIELDS: Final = frozenset(
+    {"dependencies", "devDependencies", "optionalDependencies", "peerDependencies"}
+)
+_TOML_DEPENDENCY_TABLE: Final = re.compile(
+    r"(?:^|\.)(?:dependencies|dev-dependencies|build-dependencies)$"
+)
+_CARGO_CONFIGURATION_TABLES: Final = frozenset({"features"})
+_TOML_KEY: Final = re.compile(r"^\s*([A-Za-z0-9_-]+|\"[^\"]+\"|'[^']+')\s*=")
+_REQUIREMENT_NAME: Final = re.compile(r"^\s*([A-Za-z0-9][A-Za-z0-9._-]*)")
+_QUOTED_VALUE: Final = re.compile(r"\"([^\"]*)\"|'([^']*)'")
+
+
+def _normalize_entry_name(name: str) -> str:
+    """Apply the package-name comparison normalization without accepting substrings."""
+    return re.sub(r"[-_.]+", "-", name.strip()).casefold()
+
+
+def _package_json_entry_names(text: str) -> set[str]:
+    try:
+        manifest = json.loads(text)
+    except (json.JSONDecodeError, TypeError):
+        return set()
+    if not isinstance(manifest, dict):
+        return set()
+
+    names: set[str] = set()
+    for field in _PACKAGE_DEPENDENCY_FIELDS:
+        dependencies = manifest.get(field)
+        if isinstance(dependencies, dict):
+            names.update(key for key in dependencies if isinstance(key, str))
+    config = manifest.get("config")
+    if isinstance(config, dict):
+        names.update(key for key in config if isinstance(key, str))
+    return names
+
+
+def _pyproject_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    table = ""
+    lines = _toml_lines(text)
+    index = 0
+    while index < len(lines):
+        line = lines[index]
+        table_match = re.match(r"^\s*\[([^]]+)]\s*$", line)
+        if table_match:
+            table = table_match.group(1).strip()
+            if table.startswith("tool."):
+                names.add(table.split(".", 1)[1].split(".", 1)[0])
+            index += 1
+            continue
+        key, value = _toml_assignment(line)
+        if key is None:
+            index += 1
+            continue
+        if table == "project" and key == "dependencies":
+            value, index = _toml_array_value(lines, index, value)
+            names.update(_requirement_names(value))
+        elif table == "project.optional-dependencies":
+            value, index = _toml_array_value(lines, index, value)
+            names.update(_requirement_names(value))
+        elif table.startswith("tool."):
+            names.add(key)
+        index += 1
+    return names
+
+
+def _cargo_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    table = ""
+    for line in _toml_lines(text):
+        table_match = re.match(r"^\s*\[([^]]+)]\s*$", line)
+        if table_match:
+            table = table_match.group(1).strip()
+            continue
+        key, _ = _toml_assignment(line)
+        if key is not None and (
+            _TOML_DEPENDENCY_TABLE.search(table) or table in _CARGO_CONFIGURATION_TABLES
+        ):
+            names.add(key)
+    return names
+
+
+def _toml_lines(text: str) -> tuple[str, ...]:
+    """Discard TOML comments while preserving only declaration-shaped lines."""
+    lines = []
+    for line in text.splitlines():
+        quote = ""
+        for index, char in enumerate(line):
+            if char in "\"'" and (not quote or quote == char):
+                quote = "" if quote else char
+            elif char == "#" and not quote:
+                line = line[:index]
+                break
+        lines.append(line)
+    return tuple(lines)
+
+
+def _toml_assignment(line: str) -> tuple[str | None, str]:
+    match = _TOML_KEY.match(line)
+    if not match:
+        return None, ""
+    key = match.group(1).strip("\"'")
+    return key, line[match.end():]
+
+
+def _toml_array_value(lines: tuple[str, ...], index: int, value: str) -> tuple[str, int]:
+    """Collect a multiline TOML array used for a PEP 621 dependency declaration."""
+    while value.count("[") > value.count("]") and index + 1 < len(lines):
+        index += 1
+        value += "\n" + lines[index]
+    return value, index
+
+
+def _go_mod_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    directive = ""
+    for raw_line in text.splitlines():
+        line = raw_line.split("//", 1)[0].strip()
+        if not line:
+            continue
+        if line == ")":
+            directive = ""
+            continue
+        first, *rest = line.split()
+        if first in {"require", "exclude", "replace", "retract"}:
+            directive = first
+            if rest == ["("]:
+                continue
+            if rest and rest[0] != "(":
+                names.add(rest[0])
+        elif directive:
+            names.add(first)
+    return names
+
+
+def _requirements_entry_names(text: str) -> set[str]:
+    names: set[str] = set()
+    for raw_line in text.splitlines():
+        line = raw_line.split("#", 1)[0].strip()
+        if not line or line.startswith(("-", "--")):
+            continue
+        match = _REQUIREMENT_NAME.match(line)
+        if match:
+            names.add(match.group(1))
+    return names
+
+
+def _requirement_names(value: str) -> set[str]:
+    quoted = (first or second for first, second in _QUOTED_VALUE.findall(value))
+    return {
+        match.group(1)
+        for item in quoted
+        if (match := _REQUIREMENT_NAME.match(item))
+    }
+
+
 DEFAULT_EVIDENCE_READER: Final = FileEvidenceReader()
 
 
