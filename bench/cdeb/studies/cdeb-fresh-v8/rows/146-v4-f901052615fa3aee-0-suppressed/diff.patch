+def _bounded_history_query(limit: int | None) -> tuple[str, tuple[int, ...]]:
+    if limit is None:
+        return "SELECT run_id, corrects_run_id, artifact FROM run_artifacts ORDER BY rowid", ()
+    _validate_limit(limit)
+    return (
+        "SELECT run_id, corrects_run_id, artifact FROM ("
+        "SELECT rowid, run_id, corrects_run_id, artifact FROM run_artifacts "
+        "ORDER BY rowid DESC LIMIT ?"
+        ") ORDER BY rowid",
+        (limit,),
+    )
+
+
+def _bounded_observations_query(limit: int | None) -> tuple[str, tuple[int, ...]]:
+    if limit is None:
+        return (
+            "SELECT run_id, repo, observed_at, stars FROM repository_observations "
+            "ORDER BY observation_id",
+            (),
+        )
+    _validate_limit(limit)
+    return (
+        "SELECT run_id, repo, observed_at, stars FROM ("
+        "SELECT observation_id, run_id, repo, observed_at, stars "
+        "FROM repository_observations ORDER BY observation_id DESC LIMIT ?"
+        ") ORDER BY observation_id",
+        (limit,),
+    )
+
+
+def _validate_limit(limit: int) -> None:
+    if limit <= 0:
+        raise ValueError("limit must be positive")
