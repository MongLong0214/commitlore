+def test_history_limit_returns_recent_persisted_runs_in_append_order(tmp_path) -> None:
+    # Given: three distinct artifacts were appended to the persisted store.
+    second = artifact(stars=5)
+    third = artifact(stars=6)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", artifact(stars=4))
+        store.save("second", second)
+        store.save("third", third)
+
+        # When: callers read the complete history and a recent bounded slice.
+        history = store.history()
+        recent = store.history(limit=2)
+
+    # Then: the slice retains append order and the stored artifact values.
+    assert [stored.run_id for stored in history] == ["first", "second", "third"]
+    assert [(stored.run_id, stored.corrects_run_id, stored.artifact.to_bytes()) for stored in recent] == [
+        ("second", None, second.to_bytes()),
+        ("third", None, third.to_bytes()),
+    ]
+
+
+def test_observations_limit_returns_recent_persisted_values_in_append_order(tmp_path) -> None:
+    # Given: three observations for the same repository were appended by stored runs.
+    later = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    latest = datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", artifact(stars=4, at=AT))
+        store.save("second", artifact(stars=5, at=later))
+        store.save("third", artifact(stars=6, at=latest))
+
+        # When: callers read the complete observation history and its recent slice.
+        observations = store.observations()
+        recent = store.observations(limit=2)
+
+    # Then: the slice retains append order and its persisted observation values.
+    assert [observation.run_id for observation in observations] == ["first", "second", "third"]
+    assert recent == (
+        StoredObservation("second", CANDIDATE.repo, later, 5),
+        StoredObservation("third", CANDIDATE.repo, latest, 6),
+    )
+
+
+@pytest.mark.parametrize("method", ["history", "observations"])
+@pytest.mark.parametrize("limit", [0, -1])
+def test_bounded_reads_require_a_positive_limit(tmp_path, method: str, limit: int) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(ValueError, match="limit must be positive"):
+            getattr(store, method)(limit=limit)
+
