+def test_history_limit_returns_the_newest_stored_runs_in_append_order(tmp_path) -> None:
+    # Given: three complete run artifacts were appended to a persisted store.
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", artifact(stars=4))
+        store.save("second", artifact(stars=7))
+        third = artifact(stars=9)
+        store.save("third", third)
+
+        # When: callers request the two most recently appended records.
+        recent = store.history(limit=2)
+        complete = store.history()
+
+    # Then: the slice contains the newest records, but remains append ordered.
+    assert [record.run_id for record in recent] == ["second", "third"]
+    assert recent == complete[-2:]
+    assert recent[1].artifact.to_bytes() == third.to_bytes()
+    assert [record.run_id for record in complete] == ["first", "second", "third"]
+
+
+def test_observations_limit_returns_newest_observations_in_append_order(tmp_path) -> None:
+    # Given: persisted artifacts derived one observation each as they were saved.
+    later = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    latest = datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", artifact(stars=4, at=AT))
+        store.save("second", artifact(stars=7, at=later))
+        store.save("third", artifact(stars=9, at=latest))
+
+        # When: callers request the two most recently appended observations.
+        recent = store.observations(limit=2)
+        complete = store.observations()
+
+    # Then: each existing observation value survives and the slice is append ordered.
+    assert recent == (
+        StoredObservation("second", "org/repo", later, 7),
+        StoredObservation("third", "org/repo", latest, 9),
+    )
+    assert recent == complete[-2:]
+    assert [observation.run_id for observation in complete] == ["first", "second", "third"]
+
+
+@pytest.mark.parametrize("method", ["history", "observations"])
+@pytest.mark.parametrize("limit", [0, -1])
+def test_bounded_store_reads_require_a_positive_limit(tmp_path, method, limit) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(ValueError, match="limit must be positive"):
+            getattr(store, method)(limit=limit)
+
