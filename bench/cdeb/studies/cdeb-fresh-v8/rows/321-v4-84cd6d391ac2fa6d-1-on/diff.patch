+def test_get_returns_the_requested_stored_run_and_correction_lineage(tmp_path) -> None:
+    # Given: an immutable correction points at a previous stored run.
+    original = artifact(Files(OSError("offline")))
+    correction = artifact()
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("run-1", original)
+        store.save("run-2", correction, corrects_run_id="run-1")
+
+        # When: the correction is looked up directly.
+        stored = store.get("run-2")
+
+        # Then: it retains both its own artifact and the correction relationship.
+        assert stored == StoredRun("run-2", "run-1", correction)
+
+
+def test_get_unknown_run_raises_key_error_with_the_requested_identifier(tmp_path) -> None:
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        with pytest.raises(KeyError) as error:
+            store.get("missing-run")
+
+    assert error.value.args == ("missing-run",)
+
