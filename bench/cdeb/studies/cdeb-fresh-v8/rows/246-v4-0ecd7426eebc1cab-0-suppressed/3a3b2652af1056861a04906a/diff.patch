+def test_selected_categories_require_reader_evidence_before_any_port_is_invoked() -> None:
+    class UnsupportedEvidence:
+        evidence_names = frozenset({"files"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("evidence reader should not be called")
+
+    class UnusedPort:
+        def __getattr__(self, name):
+            raise AssertionError(f"port method {name} should not be called")
+
+    with pytest.raises(
+        ValueError,
+        match="category pack 'coding-agents' names unavailable evidence: source",
+    ):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(UnusedPort(), UnusedPort(), UnusedPort(), UnusedPort(), UnsupportedEvidence()),
+        )
+
+
+def test_unreadable_files_record_absent_evidence_in_the_configured_vocabulary() -> None:
+    class CustomEvidence:
+        evidence_names = frozenset({"files", "source", "repository_topics"})
+
+        def read_evidence(self, candidate, files, metadata):
+            raise AssertionError("evidence reader should not be called without files")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("coding-agents",)),
+        RunPorts(Repository(), Files(OSError("offline")), Model(), Clock(), CustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+
+    trace = artifact.repositories[0]
+    assert {item.evidence for item in trace.category_evidence} == CustomEvidence.evidence_names
+    assert all(item.values == frozenset() and item.basis is ClaimBasis.ABSENT for item in trace.category_evidence)
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
+    assert trace.categories[0].missing_evidence == ("files", "source")
+
+
