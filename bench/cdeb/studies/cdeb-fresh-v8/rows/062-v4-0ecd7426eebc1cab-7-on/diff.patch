+def test_evidence_reader_must_support_selected_packs_before_ports_are_used() -> None:
+    events = []
+
+    class UnsupportedEvidence:
+        evidence_names = frozenset({"files"})
+
+        def read_evidence(self, candidate, files, metadata):
+            pytest.fail("an unsupported evidence reader must not be called")
+
+    class UnusedRepository:
+        def search(self, query, limit):
+            events.append("search")
+            pytest.fail("pack validation must happen before repository reads")
+
+        def metadata(self, candidate, at):
+            pytest.fail("pack validation must happen before repository reads")
+
+    class UnusedClock:
+        def now(self):
+            events.append("clock")
+            pytest.fail("pack validation must happen before clock reads")
+
+    with pytest.raises(
+        ValueError,
+        match="category pack 'coding-agents' names unavailable evidence: source",
+    ):
+        execute(
+            RunRequest("small tools", 1, ("coding-agents",)),
+            RunPorts(UnusedRepository(), Files(), Model(), UnusedClock(), UnsupportedEvidence()),
+        )
+
+    assert events == []
+
+
+def test_category_absence_uses_the_injected_reader_vocabulary_when_files_fail() -> None:
+    class CustomEvidence:
+        evidence_names = frozenset({"manifest_entries", "custom_signal"})
+
+        def read_evidence(self, candidate, files, metadata):
+            pytest.fail("evidence cannot be read without repository files")
+
+    artifact = execute(
+        RunRequest("small tools", 1, ("mcp",)),
+        RunPorts(Repository(), Files(OSError("offline")), Model(), Clock(), CustomEvidence()),
+        model_smoke=SmokeResult(True, "fixture"),
+    )
+
+    trace = artifact.repositories[0]
+    assert {(item.evidence, item.values, item.basis) for item in trace.category_evidence} == {
+        ("manifest_entries", frozenset(), ClaimBasis.ABSENT),
+        ("custom_signal", frozenset(), ClaimBasis.ABSENT),
+    }
+    assert trace.categories[0].basis is ClaimBasis.ABSENT
+    assert trace.categories[0].missing_evidence == ("manifest_entries",)
