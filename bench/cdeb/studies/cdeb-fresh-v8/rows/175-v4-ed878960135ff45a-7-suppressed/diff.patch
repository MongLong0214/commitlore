+def test_observations_are_ordered_by_recorded_time_then_recording_sequence(tmp_path) -> None:
+    # Given: a backfilled older run is saved after two runs at the same later time.
+    later = datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)
+    earlier = datetime(2026, 7, 26, 12, 0, tzinfo=timezone.utc)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("later-first", artifact(stars=8, at=later))
+        store.save("later-second", artifact(stars=9, at=later))
+        store.save("backfilled", artifact(stars=3, at=earlier))
+
+        # When: observation history is read after the out-of-order saves.
+        observations = store.observations()
+
+    # Then: time order wins, while equal times retain their recording sequence.
+    recorded = [(observation.run_id, observation.observed_at, observation.stars) for observation in observations]
+    assert recorded == [
+        ("backfilled", earlier, 3),
+        ("later-first", later, 8),
+        ("later-second", later, 9),
+    ]
+
+
