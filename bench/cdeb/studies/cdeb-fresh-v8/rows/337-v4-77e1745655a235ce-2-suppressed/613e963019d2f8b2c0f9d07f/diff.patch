     assert (mcp.pack.name, mcp.pack.version) == ("mcp", "v1")
+
+
+@pytest.mark.parametrize(
+    ("path", "manifest"),
+    (
+        ("package.json", '{"dependencies": {"MCP": "1", "ollama": "1"}}'),
+        ("pyproject.toml", '[project]\ndependencies = ["MCP>=1", "ollama"]'),
+        ("Cargo.toml", '[dependencies]\nMCP = "1"\nollama = "1"'),
+        ("go.mod", 'module example.com/project\n\nrequire (\n  MCP v1.0.0\n  ollama v1.0.0\n)'),
+        ("requirements.txt", "MCP>=1\nollama==1"),
+    ),
+)
+def test_manifest_signals_come_from_exact_declared_entry_names(path: str, manifest: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, manifest),)),
+        None,
+    )
+
+    assert evidence[1].values == frozenset({"mcp"})
+    assert evidence[2].values == frozenset({"ollama"})
+
+
+@pytest.mark.parametrize(
+    ("path", "manifest"),
+    (
+        ("package.json", '{"description": "mcp ollama", "dependencies": {"mcp-tools": "1", "ollama-client": "1"}}'),
+        ("pyproject.toml", '[project]\nname = "mcp"\ndescription = "ollama"\ndependencies = ["mcp-tools", "ollama-client"]'),
+        ("Cargo.toml", '# mcp and ollama\n[package]\nname = "mcp"\n[dependencies]\nmcp-tools = "1"\nollama-client = "1"'),
+        ("go.mod", '// mcp ollama\nmodule mcp-tools\n\nrequire ollama-client v1.0.0'),
+        ("requirements.txt", "# mcp ollama\nmcp-tools==1\nollama-client==1"),
+    ),
+)
+def test_manifest_text_and_longer_entry_names_do_not_signal_categories(path: str, manifest: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, manifest),)),
+        None,
+    )
+
+    assert evidence[1].values == frozenset()
+    assert evidence[2].values == frozenset()
+
+
+@pytest.mark.parametrize(
+    ("path", "manifest"),
+    (
+        ("package.json", '{"config": {"mcp": true, "ollama": true}}'),
+        ("pyproject.toml", "[tool.mcp]\n[tool.ollama]"),
+    ),
+)
+def test_manifest_configuration_entry_names_are_signals(path: str, manifest: str) -> None:
+    evidence = FileEvidenceReader().read_evidence(
+        Candidate("org/repo", "org", "", 0, ""),
+        FetchedFiles(((path, manifest),)),
+        None,
+    )
+
+    assert evidence[1].values == frozenset({"mcp"})
+    assert evidence[2].values == frozenset({"ollama"})
