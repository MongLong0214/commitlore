+def test_history_limit_returns_recent_runs_in_append_order(tmp_path) -> None:
+    # Given: three artifacts were durably appended to the store.
+    recorded = (artifact(stars=4), artifact(stars=7), artifact(stars=9))
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("run-1", recorded[0])
+        store.save("run-2", recorded[1], corrects_run_id="run-1")
+        store.save("run-3", recorded[2])
+
+        # When: callers request only the two most recently appended records.
+        history = store.history(limit=2)
+
+        # Then: the slice remains chronological and unbounded reads remain complete.
+        assert [run.run_id for run in store.history()] == ["run-1", "run-2", "run-3"]
+        assert [run.run_id for run in history] == ["run-2", "run-3"]
+        assert [run.corrects_run_id for run in history] == ["run-1", None]
+        assert [run.artifact.to_bytes() for run in history] == [
+            recorded[1].to_bytes(),
+            recorded[2].to_bytes(),
+        ]
+
