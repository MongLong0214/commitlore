+    def _manifest_entry_names(self, files: FetchedFiles) -> frozenset[str]:
+        entries: set[str] = set()
+        for path, text in files.files:
+            name = path.rsplit("/", 1)[-1]
+            if name not in MANIFEST_NAMES:
+                continue
+            if name == "package.json":
+                entries.update(_package_entries(text))
+            elif name in {"pyproject.toml", "Cargo.toml"}:
+                entries.update(_toml_entries(text))
+            elif name == "go.mod":
+                entries.update(_go_mod_entries(text))
+            elif name == "requirements.txt":
+                entries.update(_requirement_entries(text))
+        return frozenset(entries)
 
     def _producer_name(self, producer) -> str:
         return producer.__name__.removeprefix("_")
 
 
+def _normalized_entry(name: str) -> str:
+    """Normalize a manifest entry name without turning longer names into aliases."""
+    return re.sub(r"[-_.]+", "-", name.strip().lower())
+
+
+def _package_entries(text: str) -> frozenset[str]:
+    try:
+        manifest = json.loads(text)
+    except json.JSONDecodeError:
+        return frozenset()
+    return frozenset(_normalized_entry(key) for key in _json_keys(manifest))
+
+
+def _json_keys(value: object) -> set[str]:
+    if isinstance(value, dict):
+        keys = {key for key in value if isinstance(key, str)}
+        for item in value.values():
+            keys.update(_json_keys(item))
+        return keys
+    if isinstance(value, list):
+        return {key for item in value for key in _json_keys(item)}
+    return set()
+
+
+def _toml_entries(text: str) -> frozenset[str]:
+    entries: set[str] = set()
+    in_dependencies = False
+    collecting_dependencies = False
+    dependency_values: list[str] = []
+
+    for raw_line in text.splitlines():
+        line = _without_toml_comment(raw_line).strip()
+        if not line:
+            continue
+        if line.startswith("[") and line.endswith("]"):
+            section = line.strip("[]").strip().lower()
+            entries.add(_normalized_entry(section.rsplit(".", 1)[-1].strip(" '\"")))
+            in_dependencies = section.endswith(".dependencies") or section == "dependencies"
+            collecting_dependencies = False
+            continue
+
+        match = re.match(r"(?P<key>[^=]+?)\s*=", line)
+        if match:
+            key = match.group("key").strip().rsplit(".", 1)[-1].strip(" '\"")
+            entries.add(_normalized_entry(key))
+            collecting_dependencies = _normalized_entry(key) == "dependencies"
+            if in_dependencies:
+                collecting_dependencies = False
+
+        if collecting_dependencies or in_dependencies:
+            dependency_values.extend(re.findall(r"[\"']([^\"']+)[\"']", line))
+        if collecting_dependencies and "]" in line:
+            collecting_dependencies = False
+
+    entries.update(_normalized_requirement(value) for value in dependency_values)
+    return frozenset(entries)
+
+
+def _without_toml_comment(line: str) -> str:
+    quote = ""
+    escaped = False
+    for index, character in enumerate(line):
+        if character == "#" and not quote:
+            return line[:index]
+        if character in {"'", '\"'} and not escaped:
+            quote = "" if quote == character else character if not quote else quote
+        escaped = character == "\\" and not escaped
+    return line
+
+
+def _go_mod_entries(text: str) -> frozenset[str]:
+    source = re.sub(r"/\*.*?\*/", "", text, flags=re.DOTALL)
+    source = re.sub(r"//.*", "", source)
+    entries: set[str] = set()
+    in_require_or_replace = False
+
+    for line in source.splitlines():
+        words = line.split()
+        if not words:
+            continue
+        if words[0] in {"require", "replace"}:
+            in_require_or_replace = len(words) == 1 or words[1] == "("
+            if len(words) > 1 and words[1] != "(":
+                entries.add(_normalized_entry(words[1]))
+            continue
+        if words[0] == ")":
+            in_require_or_replace = False
+            continue
+        if in_require_or_replace:
+            entries.add(_normalized_entry(words[0]))
+    return frozenset(entries)
+
+
+def _requirement_entries(text: str) -> frozenset[str]:
+    entries = set()
+    for raw_line in text.splitlines():
+        line = raw_line.split("#", 1)[0].strip()
+        if not line or line.startswith(("-", ".", "/")):
+            continue
+        entries.add(_normalized_requirement(line))
+    return frozenset(entries)
+
+
+def _normalized_requirement(value: str) -> str:
+    match = re.match(r"\s*([A-Za-z0-9][A-Za-z0-9._-]*)", value)
+    return _normalized_entry(match.group(1)) if match else ""
+
+
 DEFAULT_EVIDENCE_READER: Final = FileEvidenceReader()
 
 
