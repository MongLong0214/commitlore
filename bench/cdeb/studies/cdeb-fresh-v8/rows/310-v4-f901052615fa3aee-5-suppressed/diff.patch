+def test_history_limit_returns_the_latest_runs_in_append_order(tmp_path) -> None:
+    # Given: three persisted artifacts in append order.
+    artifacts = (
+        artifact(stars=4, at=AT),
+        artifact(stars=9, at=datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)),
+        artifact(stars=16, at=datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc)),
+    )
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for index, recorded in enumerate(artifacts, start=1):
+            store.save(f"run-{index}", recorded)
+
+        # When: callers ask for a bounded recent history.
+        recent = store.history(limit=2)
+        complete = store.history()
+
+    # Then: the newest two records retain their chronological append order.
+    assert [run.run_id for run in recent] == ["run-2", "run-3"]
+    assert [run.artifact.to_bytes() for run in recent] == [
+        artifacts[1].to_bytes(),
+        artifacts[2].to_bytes(),
+    ]
+    assert [run.run_id for run in complete] == ["run-1", "run-2", "run-3"]
+
+
+def test_observations_limit_returns_the_latest_records_in_append_order(tmp_path) -> None:
+    # Given: persisted artifacts each derive one repository observation.
+    recorded = (
+        artifact(stars=4, at=AT),
+        artifact(stars=9, at=datetime(2026, 7, 28, 12, 0, tzinfo=timezone.utc)),
+        artifact(stars=16, at=datetime(2026, 7, 29, 12, 0, tzinfo=timezone.utc)),
+    )
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for index, artifact_to_save in enumerate(recorded, start=1):
+            store.save(f"run-{index}", artifact_to_save)
+
+        # When: callers ask for a bounded recent observation history.
+        recent = store.observations(limit=2)
+        complete = store.observations()
+
+    # Then: the records preserve their existing stored values and append order.
+    assert recent == complete[1:]
+    assert [observation.stars for observation in recent] == [9, 16]
+    assert [observation.run_id for observation in complete] == ["run-1", "run-2", "run-3"]
+
+
