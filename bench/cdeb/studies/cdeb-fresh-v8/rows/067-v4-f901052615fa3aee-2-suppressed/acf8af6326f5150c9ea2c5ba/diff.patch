+def test_history_limit_returns_the_latest_runs_in_append_order(tmp_path) -> None:
+    # Given: three persisted artifacts in append order.
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("first", artifact(stars=4))
+        store.save("second", artifact(stars=9), corrects_run_id="first")
+        store.save("third", artifact(stars=16), corrects_run_id="second")
+
+        # When: only the two most recently appended runs are requested.
+        limited = store.history(limit=2)
+
+        # Then: values are intact and the selected records remain chronological.
+        assert [record.run_id for record in store.history()] == ["first", "second", "third"]
+        assert [
+            (record.run_id, record.corrects_run_id, record.artifact.collection.candidates[0].stars)
+            for record in limited
+        ] == [
+            ("second", "first", 9),
+            ("third", "second", 16),
+        ]
+
+
