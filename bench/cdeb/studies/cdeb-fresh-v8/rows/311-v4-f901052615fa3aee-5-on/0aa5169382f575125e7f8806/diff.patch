+def test_history_limit_returns_the_recent_runs_in_append_order(tmp_path) -> None:
+    # Given: three persisted run artifacts.
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        for run_id, stars in (("first", 4), ("second", 7), ("third", 9)):
+            store.save(run_id, artifact(stars=stars))
+
+        # When: callers request the recent two runs.
+        complete_history = store.history()
+        recent_history = store.history(limit=2)
+
+    # Then: the complete history is unchanged and the bounded slice is chronological.
+    assert [stored.run_id for stored in complete_history] == ["first", "second", "third"]
+    assert [stored.run_id for stored in recent_history] == ["second", "third"]
+    assert [stored.artifact.collection.candidates[0].stars for stored in recent_history] == [7, 9]
+
