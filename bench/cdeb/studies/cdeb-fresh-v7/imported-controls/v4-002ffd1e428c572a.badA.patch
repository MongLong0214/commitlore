+        const result = validateCapabilityMatrix(document);
+        assert.equal(result.ok, false, `${eventGroup}/${runtimeId} accepted an unapproved locator`);
+        assert.ok(
+          has(result, `UNAPPROVED_EVIDENCE_LOCATOR ${eventGroup} ${runtimeId}`),
+          result.errors.join("; ")
+        );
+      }
+    }
+  });
 });
