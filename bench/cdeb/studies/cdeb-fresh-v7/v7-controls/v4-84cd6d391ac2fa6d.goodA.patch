+    def get(self, run_id: str) -> StoredRun:
+        """Return one stored run, including its correction lineage."""
+        row = self._connection.execute(
+            "SELECT corrects_run_id, artifact FROM run_artifacts WHERE run_id = ?", (run_id,)
+        ).fetchone()
+        if row is None:
+            raise KeyError(run_id)
+        corrects_run_id, artifact = row
+        return StoredRun(run_id, corrects_run_id, RunArtifact.from_bytes(bytes(artifact)))
