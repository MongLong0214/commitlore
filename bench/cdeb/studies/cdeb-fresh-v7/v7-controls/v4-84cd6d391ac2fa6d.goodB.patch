         self._connection = sqlite3.connect(path)
         self._connection.execute("PRAGMA foreign_keys = ON")
         migrate(self._connection)
+        self.records = StoredRuns(self._connection)
 
     def __enter__(self) -> SQLiteRunStore:
         return self
