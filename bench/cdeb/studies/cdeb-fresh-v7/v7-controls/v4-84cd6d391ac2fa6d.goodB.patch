+def test_stored_run_point_lookup_includes_correction_lineage(tmp_path) -> None:
+    original = artifact(stars=4)
+    correction = artifact(stars=9)
+    with SQLiteRunStore(tmp_path / "runs.db") as store:
+        store.save("original", original)
+        store.save("correction", correction, corrects_run_id="original")
+
+        stored = store.records["correction"]
+
+        with pytest.raises(KeyError) as missing:
+            store.records["missing"]
+
+    assert stored.run_id == "correction"
+    assert stored.corrects_run_id == "original"
+    assert stored.artifact.to_bytes() == correction.to_bytes()
+    assert missing.value.args == ("missing",)
+
