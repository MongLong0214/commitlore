diff --git a/gitseed/storage.py b/gitseed/storage.py
index 8111a7b..87a8fb2 100644
--- a/gitseed/storage.py
+++ b/gitseed/storage.py
@@ -18,6 +18,27 @@ class StoredRun:
     artifact: RunArtifact
 
 
+class StoredRuns:
+    """Address stored run records by their durable identifier."""
+
+    def __init__(self, connection: sqlite3.Connection) -> None:
+        self._connection = connection
+
+    def __getitem__(self, run_id: str) -> StoredRun:
+        row = self._connection.execute(
+            "SELECT run_id, corrects_run_id, artifact FROM run_artifacts WHERE run_id = ?",
+            (run_id,),
+        ).fetchone()
+        if row is None:
+            raise KeyError(run_id)
+        stored_run_id, corrects_run_id, artifact = row
+        return StoredRun(
+            str(stored_run_id),
+            None if corrects_run_id is None else str(corrects_run_id),
+            RunArtifact.from_bytes(bytes(artifact)),
+        )
+
+
