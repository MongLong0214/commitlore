{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "roles"],
  "properties": {
    "schema_version": { "const": 1 },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role_id", "prompt_path", "version", "prompt_sha256", "allowed_inputs", "forbidden_inputs", "output_schema", "stop_conditions"],
        "properties": {
          "role_id": { "type": "string", "pattern": "^[A-Z]+(?:-[A-Z])?$" },
          "prompt_path": { "type": "string", "pattern": "^roles/[a-z]+(?:-[a-z])?\\.md$" },
          "version": { "type": "integer", "minimum": 1 },
          "prompt_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "allowed_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "forbidden_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "output_schema": { "type": ["string", "null"], "pattern": "^bench/cdeb/schemas/[a-z0-9-]+\\.schema\\.json$" },
          "stop_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
