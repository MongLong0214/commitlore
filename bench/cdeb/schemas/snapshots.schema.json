{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdeb-snapshots",
  "title": "CDEB-Fresh v3 repository snapshot freeze (PRD §6.7)",
  "type": "object",
  "required": ["schema_version", "repositories"],
  "properties": {
    "schema_version": { "const": 1 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "repository_id",
          "remote_url",
          "default_branch",
          "snapshot_sha",
          "source_authorization_id",
          "frozen_at"
        ],
        "properties": {
          "repository_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "remote_url": { "type": "string", "minLength": 1 },
          "default_branch": { "type": "string", "minLength": 1 },
          "snapshot_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "source_authorization_id": { "type": "string", "minLength": 1 },
          "frozen_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
