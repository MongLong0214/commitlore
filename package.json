{
  "name": "annals",
  "version": "0.1.0-dev",
  "description": "Git commit trailers as institutional memory for AI coding agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "annals": "dist/cli.js"
  },
  "files": [
    "dist",
    "spec"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
