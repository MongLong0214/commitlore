node_modules/
# dist/ is committed so this repo installs as a Claude Code plugin with no
# registry and no publish step (ADR-0011). CI fails if it drifts from src/.
*.tsbuildinfo


# derived index — never committed (ADR-0003)
.git/commitlore/

# local bench output
bench/results/*.local.jsonl


.DS_Store

# Scratch files delegated runs leave behind.
.debug-journal.md

# Agent skill installs — tooling, not product.
#
# Anchored: unanchored, `skills/` matches a directory of that name at any depth,
# which swallowed `hermes/skills/` — a bundle this repository ships. The
# installer would then have been released with nothing to install, which is the
# same silent-incomplete-install failure twice over.
# Anchoring was not enough on its own. The bundles this repository *ships* also
# live under the root `skills/`, and they are tracked only because they predate
# this rule — so the next product bundle added there would have been ignored on
# arrival and released missing. The rule now says what it means: skills this
# repository authors are product, everything else under here is an install.
.agents/
.claude/
/skills/*
!/skills/commitlore-*/
skills-lock.json

# Staging copies `commitlore init` makes while installing dist into a
# repository. Transient, and named with a random suffix -- one survived a test
# run long enough for `git add -A` to commit 258 files of it.
.commitlore-init-dist-*/
