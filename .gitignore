node_modules/
# dist/ is committed so this repo installs as a Claude Code plugin with no
# registry and no publish step (ADR-0011). CI fails if it drifts from src/.
*.tsbuildinfo


# derived index — never committed (ADR-0003)
.git/commitlore/

# local bench output
bench/results/*.local.jsonl

.DS_Store

# Scratch files delegated runs leave behind.
.debug-journal.md

# Agent skill installs — tooling, not product.
#
# Anchored: unanchored, `skills/` matches a directory of that name at any depth,
# which swallowed `hermes/skills/` — a bundle this repository ships. The
# installer would then have been released with nothing to install, which is the
# same silent-incomplete-install failure twice over.
.agents/
.claude/
/skills/
skills-lock.json
